# -*- coding: utf-8 -*-
"""vault_rev9_stand — anvil-стенд keeper'а (и сторожа) против НАСТОЯЩЕГО `PoolVault` двух редакций ветки
`work/pool-contract-rev9`: ea165ccd (задеплоен на testnet-стенде) и de2666d7 (события для сторожа, «вывести всё», запас
газа заявок, доля ног под таймлоком). Редакция — аргумент запуска; keeper и сторож выбирают поведение по КОДУ контракта.

Контракт живёт в другой ветке (`work/pool-contract-rev9`, коммит ea165ccd — он же задеплоен на HyperEVM testnet-стенде).
`contracts/src` этой ветки — прежняя редакция (ни возврата, ни окон), и правится она в другой ветке, поэтому стенд берёт
исходники ea165ccd ИЗ ИСТОРИИ (`git archive`) во временный каталог, кладёт туда моки прекомпайлов этой ветки
(`contracts/test/mocks/CoreMocks.sol`) и собирает их своим `forge` (деплой КЕ10 — дифференциала ea165ccd:
`deploy_pool`). Свой anvil со случайным chainId на каждый раздел; чужих процессов не трогает.

Keeper поднят из КОНФИГА боевым путём (`vault_keeper.build_from_config`, ключ из env, журнал nonce `init_journal`).
Раздел ВОЗВРАТ (буфер 100 % — раздачи нет):
  RF-A1 Send ниже минимума с хвостом мельче микро -> `refundDeposit(отправитель, ровно пришедшие wei, ledgerRef, 1)`,
        событие `DepositRefunded` на цепи, деньги вернулись отправителю (Core), решение подтверждено исходящей записью
        Core хранилища, сверка G1 судима и в допуске; сторож vault_watch на этой цепи зелен (W3b по настоящему событию);
  RF-A2 возврат, ушедший в ручную очередь, пока keeper не видел `refundDeposit`, подхвачен рестартом без правки журнала;
  RF-A3 падение между подписью `refundDeposit` и квитанцией — рестарт, тот же raw, транзакция одна;
  RF-A4 падение после майнинга + ПОТЕРЯ журнала nonce — исход узнан по `DepositRefunded(ref)`, второй транзакции нет;
  RF-A5 отказ контракта (`NotActivated` адресата) — стоп денежных операций, транзакции нет.
Раздел ОКНА НОГ (буфер 10 % — раздача ногам):
  WIN-A1 раздача -> приход на ноги -> `confirmSweep` -> `legToPerp`; зачисление после раздачи не висит на `LegBusy`;
  WIN-A2 вывод: `legSendToVault` -> запись Core «с ноги» -> `confirmLegSend` -> выплата подтверждена; сверка в допуске;
  WIN-A3 падение посреди окна (раздача замайнена, окна открыты) -> рестарт, одно подтверждение;
  WIN-A4 подтверждение замайнено + ПОТЕРЯ журнала nonce -> исход по `LegTransferConfirmed` на цепи;
  WIN-A5 отказ: раздача молча не дошла — подтверждения нет, окна открыты, стоп денежных операций (решение человека).
Редакция de2666d7 — те же разделы (доля ног 60/40 из конструктора, событие возврата с полем token, трёхаргументный
`requestWithdraw`, `processWithdrawals` с запасом газа CALL_GAS) и раздел СОБЫТИЯ И ЗАЯВКИ:
  EV-A1 честный поток (депозит -> раздача -> вход/марк/закрытие -> понедельник по расписанию -> вывод): сторож по
        СОБЫТИЯМ (свёртка ордеров, Σ realized, MondaySettled, ShortfallCovered) зелен, редакция узнана по коду;
  EV-A2 «вывести всё» при лимите блока 30M (оценка + 2×CALL_GAS не помещается) — keeper ждёт с инцидентом, транзакции
        нет; лимит поднят — исполнено одной транзакцией, выведена свободная доля;
  EV-A3 саботаж keeper'а «газ без запаса» — НАСТОЯЩИЙ контракт майнит пустую транзакцию (оценка находит путь «ничего
        не сделал»), keeper встаёт по «nextIntent не сдвинулся»;
  EV-S* саботажи ключом keeper'а/admin'а, каждый со снимка: sizeOrder не того нотионала (W9), расчёт недели раньше T_пн
        (W8:early), предложение и смена доли ног (WR, тревога без стопа).

Финальная редакция ba1d6abb (`work/pool-contract-final`, модуль аварии) — разделы возврата и окон и раздел ФИНАЛ:
  FN-A0..A2 редакция по коду, честный поток со сторожем, «вывести всё» обычным газом (нехватка — откат IntentStarved);
  FN-A3     объявление аварии admin'ом (вид 7) — keeper встал, сторож — стоп;
  FN-A4/A5  заморозка любым (триггер 6) — keeper не шлёт ничего, артефакт капитала закрыт, страж клиента не подписывает;
  FN-A6     снимок, сбор с ноги, забирание доли любым — сторож сводит их записи Core.

Запуск:  python contracts/diff/vault_rev9_stand.pytxt run [ea165ccd|de2666d7|ba1d6abb]   (по умолчанию ea165ccd;
         Foundry — HL_FOUNDRY_BIN или PATH)
"""
from __future__ import annotations

import io
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
from datetime import datetime, timezone
from decimal import Decimal
from importlib.machinery import SourceFileLoader

sys.stdout.reconfigure(encoding="utf-8")
HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.abspath(os.path.join(HERE, "..", ".."))
KS = sys.modules.get("vault_keeper_stand") or SourceFileLoader("vault_keeper_stand", os.path.join(
    HERE, "vault_keeper_stand.pytxt")).load_module()
WS = sys.modules.get("vault_watch_stand") or SourceFileLoader("vault_watch_stand", os.path.join(
    HERE, "vault_watch_stand.pytxt")).load_module()
ABI, RPC, VK, OB, VW, VC = KS.ABI, KS.RPC, KS.VK, KS.OB, WS.VW, WS.VC
MICRO = VK.MICRO
CONTRACT_COMMIT = "ea165ccd57a107028d34b0d1fcc09a79e4578cfb"     # контракт testnet-стенда (манифест e105)
# Редакции контракта: коммит, доля ноги A конструктора (None — параметра нет, пополам), форма заявки и события возврата.
EDITIONS = {
    "ea165ccd": {"commit": CONTRACT_COMMIT, "share": None,
                 "request": lambda amt: ("requestWithdraw(uint256,bool)", [amt, False]),
                 "refunded": ("DepositRefunded(address,uint256,bytes32,uint8)", [True, False, True, False],
                              lambda to, wei, ref, why: [to, wei, ref, why])},
    "de2666d7": {"commit": "de2666d7a3f50bc55dfc9a741e09fbce9d11bf5d", "share": 6000,
                 "request": lambda amt: ("requestWithdraw(uint256,bool,bool)", [amt, False, False]),
                 "refunded": ("DepositRefunded(address,uint64,uint64,bytes32,uint8)", [True, False, False, True, False],
                              lambda to, wei, ref, why: [to, 0, wei, ref, why])},
    # финальная (`work/pool-contract-final`): + модуль аварии `PoolVaultEmergency`; сроки триггеров по времени — заведомо
    # дальше стенда (заморозку стенд вызывает объявлением admin'а, триггер 6), не меньше `DELAY` (0)
    "ba1d6abb": {"commit": "ba1d6abb5de6d8a2da95c19397dae54100d90bbf", "share": 6000,
                 "request": lambda amt: ("requestWithdraw(uint256,bool,bool)", [amt, False, False]),
                 "refunded": ("DepositRefunded(address,uint64,uint64,bytes32,uint8)", [True, False, False, True, False],
                              lambda to, wei, ref, why: [to, 0, wei, ref, why]),
                 "terms": {"t_stuck": 10 ** 9, "t_dead": 10 ** 9, "t_nomonday": 10 ** 9, "t_serve": 10 ** 9}},
    # исправления враждебного ревью 20.10 — два пакета от ba1d6abb, пока не слиты: A (`work/pool-contract-final` fixA —
    # заявки без try, PositionReduced, граница 43) и B (fixB — poolSink, В7′ по сроку T_QUEUE_MAX, часы с депозита)
    "c3deb740": {"commit": "c3deb740", "share": 6000, "review": True,
                 "request": lambda amt: ("requestWithdraw(uint256,bool,bool)", [amt, False, False]),
                 "refunded": ("DepositRefunded(address,uint64,uint64,bytes32,uint8)", [True, False, False, True, False],
                              lambda to, wei, ref, why: [to, 0, wei, ref, why]),
                 "terms": {"t_stuck": 10 ** 9, "t_dead": 10 ** 9, "t_nomonday": 10 ** 9, "t_serve": 10 ** 9}},
    "a2f97d59": {"commit": "a2f97d59", "share": 6000, "review": True,
                 "request": lambda amt: ("requestWithdraw(uint256,bool,bool)", [amt, False, False]),
                 "refunded": ("DepositRefunded(address,uint64,uint64,bytes32,uint8)", [True, False, False, True, False],
                              lambda to, wei, ref, why: [to, 0, wei, ref, why]),
                 # срок очереди В7′ — двое суток (стенд прыгает часами через него), прочие сроки — заведомо дальше стенда
                 "terms": {"t_stuck": 10 ** 9, "t_dead": 10 ** 9, "t_nomonday": 10 ** 9, "t_serve": 10 ** 9,
                           "t_queue_max": 2 * 24 * 3600}},
    # ред. 9.5 (`work/pool-contract-fixC` @99dcf952 = 9.5 bc91f286 + стенды/шапка): пакеты A+B, ревью-2 (dumpState,
    # постраничная история, DELAY >= 24 ч, сроки >= 2·DELAY), внеочередной расчёт monday(bool) и предел maxGens. Доля ног
    # 5000 (решение оператора 21.10: две ноги 50/50). Разделы с таймлоком (final, review) здесь не идут: DELAY стенда
    # теперь не 0, а их сценарии исполняют предложения сразу
    "99dcf952": {"commit": "99dcf95253ad0d54bf4b88fc619e9ae8bd0c3ae7", "share": 5000, "delay": 86_400,
                 "max_gens": 1000, "archive_extra": ("config/operational_limits.json",),
                 "request": lambda amt: ("requestWithdraw(uint256,bool,bool)", [amt, False, False]),

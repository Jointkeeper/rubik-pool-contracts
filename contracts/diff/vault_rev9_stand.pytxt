    "d064ffbe": {"commit": "d064ffbe", "share": 5000, "delay": 86_400,
                 "max_gens": 1000, "archive_extra": ("config/operational_limits.json",),
                 "request": lambda amt: ("requestWithdraw(uint256,bool,bool)", [amt, False, False]),

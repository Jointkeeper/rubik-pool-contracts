# -*- coding: utf-8 -*-
"""pool_ledger_diff — дифференциал контракта `PoolLedger` с эталоном `runtime/vault_accounting.pytxt`.

Поднимает `anvil` (С лимитом EIP-170 — реализации обязаны в него помещаться), деплоит контракт и проигрывает каждую
фикстуру `tests/fixtures/vault_accounting/*.json` вызов за вызовом (все сценарии ред. 9.1 — фикстуры эталона, своих
сценариев у дифференциала нет). На каждом шаге судится:
  1. ПРИНЯТ ли вызов — так же, как в эталоне (отказ эталона = revert контракта);
  2. СОСТОЯНИЕ после вызова — всё, число в число (допуск 0), после нормализации «отсутствующий счёт = 0»;
  3. ВИТРИНЫ действующего адреса, если фикстура их несёт (`investor_view`, `referrer_view`).
Первое расхождение печатается с именем поля, обоими значениями и номером вызова; rc != 0.

ABI-кодек — общий владелец `runtime/evm_abi.pytxt` (вынесен отсюда 2026-10-18; селфтест C1 ниже сверяет ЕГО с
`cast abi-encode`). Селекторы берутся из `methodIdentifiers` артефакта forge, а не считаются здесь.

Запуск:  python contracts/diff/pool_ledger_diff.pytxt run [--only scenario_200] [--verbose] [--paged | --paged-k K] [--fuzz N] [--jobs 8]
         python contracts/diff/pool_ledger_diff.pytxt mutants [--all] [--only <подстрока>] [--start <подстрока>] [--fuzz N]
         python contracts/diff/pool_ledger_diff.pytxt mutants --vault [--all] [--only <подстрока>] [--start <подстрока>]
         python contracts/diff/pool_ledger_diff.pytxt rehearse-deploy [--out manifest.json]
         python contracts/diff/pool_ledger_diff.pytxt postdeploy --rpc <url> --manifest <file> [--spacing 1.0]
         python contracts/diff/pool_ledger_diff.pytxt selftest
`--paged` — недельный расчёт пачками по одной единице каждого этапа (`mondayStep(1)` до конца, затем `mondayEnd`),
`--paged-k K` — по K единиц; `--fuzz N` — ещё N сценариев эталона с длинной очередью заявок (`queue_calls`).
`mutants --vault` — саботаж хранилища `PoolVault.sol` (словарь `VAULT_MUTANTS`, судья — forge-стенды `PoolVaultTest`);
раннер мутантов хранилища ОДИН — новые мутанты хранилища добавляются в этот словарь, второй раннер не заводится.
Foundry — каталог HL_FOUNDRY_BIN или PATH (резолвер владельца — `analysis/e96_vault_research_gate.tool`)."""
from __future__ import annotations
import argparse, glob, http.client, json, os, random, re, socket, subprocess, sys, threading, time
from importlib.machinery import SourceFileLoader
sys.stdout.reconfigure(encoding="utf-8")

ROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."))
CONTRACTS = os.path.join(ROOT, "contracts")
ARTIFACT = os.path.join(CONTRACTS, "out", "PoolLedger.sol", "PoolLedger.json")
VIEWS_ARTIFACT = os.path.join(CONTRACTS, "out", "PoolLedger.sol", "PoolLedgerViews.json")
MONDAY_ARTIFACT = os.path.join(CONTRACTS, "out", "PoolLedger.sol", "PoolLedgerMonday.json")
PROJ_ARTIFACT = os.path.join(CONTRACTS, "out", "PoolLedger.sol", "PoolLedgerProj.json")
EMERGENCY_ARTIFACT = os.path.join(CONTRACTS, "out", "PoolLedger.sol", "PoolLedgerEmergency.json")
BOOK_ARTIFACT = os.path.join(CONTRACTS, "out", "PoolLedger.sol", "PoolLedgerBook.json")       # ред. 9.5: книга ордеров
VAULT_ARTIFACT = os.path.join(CONTRACTS, "out", "PoolVault.sol", "PoolVault.json")
LEG_ARTIFACT = os.path.join(CONTRACTS, "out", "TradingLeg.sol", "TradingLeg.json")
VAULT_EM_ARTIFACT = os.path.join(CONTRACTS, "out", "PoolVaultEmergency.sol", "PoolVaultEmergency.json")
# реализации бухгалтерии на ОДНОЙ памяти (PoolLedger исполняет их делегированным вызовом): раскладка обязана совпасть
LEDGER_PARTS = ("PoolLedger", "PoolLedgerViews", "PoolLedgerMonday", "PoolLedgerProj", "PoolLedgerEmergency", "PoolLedgerBook")
EIP170 = 24_576                # предел runtime-кода
EIP3860 = 49_152               # предел initcode
MANIFEST_SCHEMA = "pool_deploy_manifest_v1"
POOL_CREDITOR = "0x" + "0" * 40      # ключ «долг перед пулом» в книге доплативших во внешнем виде (эталон POOL_CREDITOR)
FIXTURES = os.path.join(ROOT, "tests", "fixtures", "vault_accounting")
GAS = 1_000_000_000            # газ на вызов: проекции эталона обходят всех; газ судит этап 5, не дифференциал
CHAIN_LOCK = threading.Lock()
ABI = sys.modules.get("evm_abi") or SourceFileLoader("evm_abi", os.path.join(ROOT, "runtime", "evm_abi.pytxt")).load_module()
# разбор `dump()` и нормальная форма эталона — владелец `runtime/pool_ledger_dump.pytxt` (2026-10-18: его зовёт и keeper)
DUMP = sys.modules.get("pool_ledger_dump") or SourceFileLoader("pool_ledger_dump", os.path.join(ROOT, "runtime", "pool_ledger_dump.pytxt")).load_module()

PATH = {"spot": 0, "evm": 1}
FIXTURE_SCHEMA = "vault_accounting_fixture_v9"      # пакет безопасности: в `constants` минимум депозита и предел адресов,
#                                                    в вызовах — `refund_deposit`; ред. 9: книга доплативших, операторов нет
PARTNER = DUMP.PARTNER
ORDER_STATE = DUMP.ORDER_STATE
PAGED_MAX_STEPS = 50_000         # пачек одного расчёта: больше — расчёт не сходится (фикстурам нужно на порядки меньше)
MS_DONE = 7                    # этап недельного расчёта «осталось mondayEnd» (`PoolLedgerBase.MS_DONE`)
EM_READY = 2                   # ред. 9.4: `emergencyTotals()[0]` — снимок готов (0 — живой пул, 1 — идёт проход итогов)
BPS = 10_000                   # доля ноги A в раздаче (`legShareBps`): 0..BPS, нога B — остаток
CORE_USER_EXISTS = "0x" + "0" * 37 + "810"     # прекомпайл HyperCore `coreUserExists` (HLConstants)


def foundry(name: str) -> str:
    e96 = sys.modules.get("e96_gate") or SourceFileLoader(
        "e96_gate", os.path.join(ROOT, "analysis", "e96_vault_research_gate.pytxt")).load_module()
    return e96.tool(name)


# --- ABI ------------------------------------------------------------------------------------------------------ #
# Кодек — владелец `runtime/evm_abi.pytxt`, разбор `dump()`/страниц истории — владелец `runtime/pool_ledger_dump.pytxt`
# (вынесены 2026-10-18 веткой keeper'а; слияние 2026-10-22 свело к ним и код ред. 9.5). Имена ниже — ССЫЛКИ на владельцев,
# не копии: второго кодека и второго разбора раскладки в дереве нет (§I.9).
U256 = ABI.U256
encode, signed, dec_int_array, dec_fixed, addr_of = ABI.encode, ABI.signed, ABI.dec_int_array, ABI.dec_fixed, ABI.addr_of
# слов на ордер в выгрузке финального контракта: (gen, state, notional, upnl, sized_week, partR) — ред. 9.3 частичное закрытие
ORDER_WORDS = 6


def parse_dump(w: list) -> dict:
    """Разбор `dump()` / `dumpState()` в нормальную форму дифференциала (раскладка — `PoolLedgerViews._dumpHead/_dumpTail`)."""
    return DUMP.parse(w, un_id32, order_words=ORDER_WORDS)


def dec_page(data: bytes) -> tuple:
    """`(uint256, bytes32[])` — страница истории (`closedPids`, `ledgerRefs`): (всего, [слова как int])."""
    total, page = DUMP.decode_page(data)
    return total, [int(x, 16) for x in page]


def id32(s) -> bytes:
    """`pid` / `ledger_ref` эталона (строка <= 32 байт UTF-8) -> bytes32; None -> нули (контракт отвергнет, как эталон)."""
    if s is None:
        return bytes(32)
    b = s.encode("utf-8")
    if not b or len(b) > 32:
        raise ValueError(f"id32: {s!r}")
    return b + bytes(32 - len(b))


def un_id32(v: int) -> str:
    return (v % ABI.U256).to_bytes(32, "big").rstrip(b"\x00").decode("utf-8")


# --- anvil ---------------------------------------------------------------------------------------------------- #
class Chain:
    def __init__(self):
        # порт выбирается и занимается anvil'ом под замком: иначе два потока одного прогона могли бы получить один порт
        # и проиграть две фикстуры на одной цепи
        with CHAIN_LOCK:
            self._start()

    def _start(self):
        """Свой anvil, а не чужой: при занятом порте (гонка `bind(0)` -> закрыть -> `anvil --port P` с соседним процессом)
        anvil молча выходит, а опрос порта отвечал бы ЧУЖОЙ цепью — прогон сел бы на неё. Поэтому у цепи уникальный
        `--chain-id`, и она принята, только если процесс жив И `eth_chainId` равен своему; иначе — новый порт."""
        for _attempt in range(5):
            with socket.socket() as s:
                s.bind(("127.0.0.1", 0)); self.port = s.getsockname()[1]
            self.chain_id = random.SystemRandom().randrange(1 << 20, 1 << 48)
            # лимит размера кода НЕ снят: оба контракта обязаны в него помещаться (EIP-170), это часть проверки
            self.proc = subprocess.Popen([foundry("anvil"), "--port", str(self.port), "--chain-id", str(self.chain_id),
                                          "--disable-block-gas-limit", "--silent", "--accounts", "1"],
                                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.url = f"http://127.0.0.1:{self.port}"
            self.conn = None
            for _ in range(100):
                if self.proc.poll() is not None:
                    break                                   # свой anvil вышел (порт занят) — отвечать может только чужой
                try:
                    cid = int(self.rpc("eth_chainId"), 16)
                except OSError:
                    time.sleep(0.1); continue
                if cid != self.chain_id:
                    break                                   # отвечает чужая цепь на том же порте
                self.me = self.rpc("eth_accounts")[0]
                self.nid = 0
                return
            else:
                self.close(); raise ValueError("anvil не поднялся за 10 с")
            self.close()
        raise ValueError("anvil: 5 попыток подряд порт оказался занят чужой цепью")

    def rpc(self, method, *params):
        """Одно постоянное соединение на цепь (keep-alive): соединение на запрос при нескольких цепях сразу исчерпывает
        эфемерные порты Windows (TIME_WAIT) — замер: WinError 10060 на восьми параллельных фикстурах."""
        body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": list(params)}).encode()
        for attempt in (0, 1):
            if self.conn is None:
                self.conn = http.client.HTTPConnection("127.0.0.1", self.port, timeout=120)
            try:
                self.conn.request("POST", "/", body, {"Content-Type": "application/json"})
                out = json.loads(self.conn.getresponse().read())
                break
            except (http.client.HTTPException, ConnectionError):
                # anvil закрыл простаивающее соединение: один переподключённый повтор (запрос до него не дошёл)
                self.conn.close(); self.conn = None
                if attempt:
                    raise
        if "error" in out:
            raise RpcError(out["error"])
        return out["result"]

    def receipt(self, h) -> dict:
        """Квитанция появляется не в ответе на отправку, а когда anvil смайнит блок (замер: десятки мс)."""
        for _ in range(600):
            rc = self.rpc("eth_getTransactionReceipt", h)
            if rc:
                return rc
            time.sleep(0.01)
        raise ValueError(f"нет квитанции {h} за 6 с")

    def close(self):
        if self.conn is not None:
            self.conn.close()
        self.proc.terminate()
        try:
            self.proc.wait(10)
        except subprocess.TimeoutExpired:
            self.proc.kill()


class RpcError(Exception):
    pass


class Ledger:
    """Обёртка контракта: вызовы по именам эталона, ответ — «принят ли»."""
    def __init__(self, chain: Chain, art: dict, constants: dict, paged: bool = False):
        self.c = chain; self.paged = paged
        # витрины живут в PoolLedgerViews и вызываются через fallback PoolLedger: селекторы — объединение двух артефактов
        self.sel = dict(art["views"]["methodIdentifiers"]); self.sel.update(art["methodIdentifiers"])
        impl = {name: deploy_code(chain, art[name]["bytecode"]["object"], f"реализации {name}")
                for name in ("views", "monday", "proj", "emergency", "book")}
        # владелец — ключ цепи: дифференциал судит бухгалтерию без хранилища (связность хранилища — `deploy_pool`)
        self.addr = deploy_code(chain, art["bytecode"]["object"] + ledger_ctor(constants, impl["views"], impl["monday"],
                                                                               impl["proj"], impl["emergency"], chain.me,
                                                                               impl["book"]).hex(),
                                "PoolLedger")
        self.treasury = constants["treasury"].lower()
        self.frozen = False; self.result = None       # ред. 9.4: пул заморожен; результат последнего вызова с `result`
        for p in constants["partners"]:
            self.must("initPartner(address)", ["address"], [p])
        # ред. 9.5 (спека 8.15): предел поколений — аргумент конструктора (`ledger_ctor`, как у эталона `GenLedger(max_gens)`);
        # ключ есть только у фикстуры 266, у прочих — 0, «правила нет». Поколений с последнего расчёта — по номеру поколения
        # на последнем принятом расчёте (поколения нумеруются подряд, расчёт их не открывает)
        self.max_gens = max_gens_of(constants); self.gen_at_settle = 0; self.settled = False

    def data(self, sig, types, values) -> str:
        if sig not in self.sel:
            raise ValueError(f"у контракта нет {sig}")
        return "0x" + self.sel[sig] + ABI.encode(types, values).hex()

    def send(self, sig, types, values) -> bool:
        h = self.c.rpc("eth_sendTransaction", {"from": self.c.me, "to": self.addr, "data": self.data(sig, types, values),
                                               "gas": hex(GAS)})
        return int(self.c.receipt(h)["status"], 16) == 1

    def next_week(self):
        """Ревью-3b: календарный расчёт контракта — не чаще одного за календарную неделю (`_calWeek` по `block.timestamp`); у
        эталона времени нет, каждый его календарный расчёт — новая неделя. Поэтому перед КАЖДЫМ календарным расчётом цепь
        сдвигается на 7 суток: номер недели следующего блока растёт ровно на единицу. Внеочередной расчёт время не двигает."""
        self.c.rpc("evm_increaseTime", 7 * 86400)

    def must(self, sig, types, values):
        if not self.send(sig, types, values):
            raise ValueError(f"{sig}{values}: служебный вызов отклонён")

    def call(self, sig, types, values) -> bytes:
        return bytes.fromhex(self.c.rpc("eth_call", {"from": self.c.me, "to": self.addr, "data": self.data(sig, types, values),
                                                     "gas": hex(GAS)}, "latest")[2:])

    def try_call(self, sig, types, values):
        try:
            return self.call(sig, types, values)
        except RpcError:
            return None

    def apply(self, c) -> bool:
        ok = self._apply(c)
        if ok and c["call"] == "monday":
            self.settled = True                         # ред. 9.5: номер поколения на расчёте — следующей выгрузкой
        return ok

    def _apply(self, c) -> bool:
        k = c["call"]; i = lambda x: int(x)
        if k == "deposit":
            payout = 0 if c["payout"] is None else (2 if c["payout"] else 1)
            return self.send("deposit(address,uint256,address,uint8,uint8,bytes32)",
                             ["address", "uint256", "address", "uint8", "uint8", "bytes32"],
                             [c["addr"], i(c["amount"]), c["referrer"] or "0x" + "0" * 40, payout, PATH[c["path"]],
                              id32(c["ledger_ref"])])
        if k == "withdraw":
            return self.withdraw(c["addr"], i(c["amount"]), c["reward"])
        if k == "size_order":
            return self.send("sizeOrder(bytes32,uint256)", ["bytes32", "uint256"], [id32(c["pid"]), i(c["notional"])])
        if k in ("fill_order", "cancel_order"):
            return self.send({"fill_order": "fillOrder(bytes32)", "cancel_order": "cancelOrder(bytes32)"}[k], ["bytes32"], [id32(c["pid"])])
        if k == "mark_position":
            return self.send("markPosition(bytes32,int256)", ["bytes32", "int256"], [id32(c["pid"]), i(c["upnl"])])
        if k == "close_position":
            return self.send("closePosition(bytes32,int256)", ["bytes32", "int256"], [id32(c["pid"]), i(c["realized"])])
        if k == "reduce_position":
            return self.send("reducePosition(bytes32,int256,uint256,int256)", ["bytes32", "int256", "uint256", "int256"],
                             [id32(c["pid"]), i(c["realized"]), i(c["notional"]), i(c["upnl"])])
        if k == "monday" and c.get("calendar", True) is False and not self.paged:
            # ред. 9.5 (спека 8.15): внеочередной расчёт — неделя не сдвигается; у контракта без него — громкий отказ `data`
            return self.send("monday(bool)", ["bool"], [False])
        if k == "monday" and self.paged:
            return self.monday_paged(c.get("calendar", True) is not False)
        if k == "monday":
            self.next_week()                            # календарный атомарный: новая календарная неделя (ревью-3b)
        if k in ("monday", "sweep_to_perp", "pay_queue", "treasury_payout"):
            return self.send({"monday": "monday()", "sweep_to_perp": "sweepToPerp()", "pay_queue": "payQueue()",
                              "treasury_payout": "treasuryPayout()"}[k], [], [])
        if k == "claim":
            return self.send("claim(address)", ["address"], [c["addr"]])
        if k == "set_payout_mode":
            return self.send("setPayoutMode(address,bool)", ["address", "bool"], [c["addr"], c["payout"]])
        if k == "set_withdrawable":
            return self.send("setWithdrawable(uint256)", ["uint256"], [i(c["amount"])])
        if k == "set_partner":
            return self.send("setPartner(address,uint8)", ["address", "uint8"], [c["addr"], PARTNER[c["status"]]])
        if k == "cover_shortfall":
            return self.send("coverShortfall(uint256,uint8,bytes32)", ["uint256", "uint8", "bytes32"],
                             [i(c["amount"]), PATH[c["path"]], id32(c.get("ledger_ref"))])
        if k == "refund_deposit":
            return self.send("refundRef(bytes32)", ["bytes32"], [id32(c["ledger_ref"])])
        if k == "emergency_freeze":
            return self.freeze()
        if k == "emergency_due":
            m = i(c["m_cum"])
            raw = None if m < 0 or m >= U256 else self.try_call("emergencyDue(address,uint256)", ["address", "uint256"],
                                                                 [c["addr"], m])
            self.result = None if raw is None else dec_fixed(raw, 1)[0]
            return raw is not None
        raise ValueError(f"вызов {k} дифференциалом не поддержан")

    # коды исхода `withdraw` (`PoolLedgerBase.W_*`): бизнес-отказ эталона контракт возвращает КОДОМ, а не отказом транзакции
    W_CODES = {0: "ok", 1: "withdraw: amount", 2: "uint128"}

    def withdraw(self, addr: str, amount: int, reward: bool) -> bool:
        """КОДЕК СТАТУСА `withdraw`: принят ли вызов — так же, как в эталоне. Бизнес-отказ эталона (`withdraw: …` — ноль или сверх
        свободной доли, `_amount` — вне uint128) контракт отдаёт кодом при успешной транзакции; прочие отказы — отказ транзакции.
        Код читается `eth_call` на том же состоянии, затем вызов отправляется: транзакция обязана пройти тогда и только тогда,
        когда прошёл `eth_call` (иначе — расхождение, а не «принят»), а код вне известных — расхождение. Что отказ кодом
        состояние не тронул, судит сравнение состояния после вызова (эталон отказа не меняет ничего)."""
        args = (["address", "uint256", "bool"], [addr, amount, reward])
        raw = self.try_call("withdraw(address,uint256,bool)", *args)
        sent = self.send("withdraw(address,uint256,bool)", *args)
        if (raw is not None) != sent:
            raise ValueError(f"withdraw: eth_call {'прошёл' if raw is not None else 'отказал'}, а транзакция "
                             f"{'прошла' if sent else 'отказала'} на том же состоянии")
        if raw is None:
            return False
        code = dec_fixed(raw, 3)[0]
        if code not in self.W_CODES:
            raise ValueError(f"withdraw: код исхода {code} вне известных {self.W_CODES}")
        return code == 0

    def freeze(self) -> bool:
        """Ред. 9.4: заморозка и проход итогов снимка пачками по `paged` держателей (атомарная форма — все сразу) до готовности;
        эталон замораживает атомарно. Пачка, после которой проход не сдвинулся, — отказ (снимок не сходится, раздача заперта)."""
        if not self.send("emergencyFreeze()", [], []):
            return False
        k = int(self.paged) or U256 - 1; prev = None
        for _ in range(PAGED_MAX_STEPS):
            tot = dec_fixed(self.call("emergencyTotals()", [], []), 9)
            if tot[0] == EM_READY:
                self.frozen = True
                return True
            if tot[2] == prev:
                raise ValueError(f"emergencySnapStep({k}) не сдвинул проход итогов: пройдено {tot[2]}")
            prev = tot[2]
            if not self.send("emergencySnapStep(uint256)", ["uint256"], [k]):
                raise ValueError(f"emergencySnapStep отклонён посреди прохода (пройдено {tot[2]}) — раздача заперта")
        raise ValueError(f"emergencySnapStep: {PAGED_MAX_STEPS} пачек, а снимок не готов")

    def progress(self) -> tuple:
        """(этап, единиц этапа сделано, осталось, открыт ли расчёт) — `mondayProgress()`."""
        w = ABI.dec_fixed(self.call("mondayProgress()", [], []), 4)
        return w[0], w[1], w[2], bool(w[3])

    def monday_paged(self, calendar: bool = True) -> bool:
        """Тот же недельный расчёт пачками по `paged` единиц каждого этапа (по умолчанию ОДНОЙ: строка, реферальная доля,
        работа возврата, (должник, поколение) раздела, строка таблицы «весь пул») — исход обязан совпасть с атомарным
        эталоном. Пачка, после которой ход расчёта не сдвинулся, — отказ: шаги стоят на месте, а пул заперт открытым
        расчётом."""
        # ред. 9.5 (спека 8.15): внеочередной расчёт открывается `mondayBegin(false)` — неделя не сдвигается
        if calendar:
            self.next_week()                            # ревью-3b: календарный расчёт — новая календарная неделя
        began = self.send("mondayBegin()", [], []) if calendar else self.send("mondayBegin(bool)", ["bool"], [False])
        if not began:
            return False
        prev = None; steps = 0
        while True:
            cur = self.progress()
            if cur[0] == MS_DONE:
                break
            steps += 1
            if steps > PAGED_MAX_STEPS:
                raise ValueError(f"mondayStep: {PAGED_MAX_STEPS} пачек, а расчёт не кончился (этап {cur[0]}) — шаги не сходятся")
            if cur[:2] == prev:
                raise ValueError(f"mondayStep({int(self.paged)}) не сдвинул расчёт: этап {cur[0]}, сделано {cur[1]}, осталось {cur[2]}")
            prev = cur[:2]
            if not self.send("mondayStep(uint256)", ["uint256"], [int(self.paged)]):
                raise ValueError(f"mondayStep отклонён посреди открытого расчёта (этап {cur[0]}) — пул заперт")
        if not self.send("mondayEnd()", [], []):
            raise ValueError("mondayEnd отклонён — пул заперт в открытом расчёте")
        return True

    # --- состояние ---------------------------------------------------------------------------------------- #
    def state(self) -> dict:
        w = dec_int_array(self.call("dump()", [], []))
        st = parse_dump(w)
        self.history_views(st, w)
        if self.frozen:                                 # ред. 9.4: ключ `emergency` — только у замороженного пула, как у эталона
            e = dec_int_array(self.call("emergencyDump()", [], []))
            z = dict(zip(("week", "F_T", "H", "E", "S", "P"), e[:6])); z["treasury"] = self.treasury
            n = e[6]; z["planes"] = {addr_of(e[7 + 4 * j]): tuple(e[8 + 4 * j: 11 + 4 * j]) for j in range(n)}
            if 7 + 4 * n != len(e) or len(z["planes"]) != n:
                raise ValueError(f"emergencyDump: {len(e)} слов при {n} держателях — раскладка разошлась")
            st["emergency"] = z
        return st

    def history_views(self, st: dict, w: list):
        """Ревью-2, #1 / #3 — витрины keeper'а против выгрузки на КАЖДОМ шаге: `liveGenCount` = число поколений выгрузки;
        `dumpState` = выгрузка без истории (та же раскладка, длины списков истории 0); `closedPids`/`ledgerRefs` —
        страницы [0, s) + [s, ∞) склеиваются в список выгрузки, `from` за концом — пустая страница при той же длине;
        `isClosedPid`/`isLedgerRef` — истина на последнем элементе списка, ложь на живом ордере и на ни разу не виданном id."""
        g = dec_fixed(self.call("liveGenCount()", [], []), 1)[0]
        if g != len(st["snaps"]):
            raise ValueError(f"liveGenCount() = {g}, а поколений в выгрузке {len(st['snaps'])}")
        # ред. 9.5: `genLimits()` — (предел, поколений с последнего расчёта, ЖИВЫХ); живое — текущее или с ордером sized/open.
        # Список живых ведёт контракт (закрытие окончательного поколения в close/cancel/sizeOrder), выгрузка — эталон
        if self.settled:
            self.gen_at_settle = st["gen"]; self.settled = False
        live = sum(1 for q in st["snaps"] if q == st["gen"] or any(o[0] == q and o[1] in (1, 2) for o in st["orders"].values()))
        lim = tuple(dec_fixed(self.call("genLimits()", [], []), 3))
        want = (self.max_gens, st["gen"] - self.gen_at_settle, live)
        if lim != want:
            raise ValueError(f"genLimits() = {lim}, а по выгрузке (предел, с расчёта, живых) {want}")
        bare = parse_dump(dec_int_array(self.call("dumpState()", [], [])))
        if bare["closed_pids"] or bare["ledger_refs"]:
            raise ValueError("dumpState(): история не пуста")
        want = dict(st, closed_pids=[], ledger_refs=[])
        if bare != want:
            bad = sorted(k for k in want if bare.get(k) != want[k])
            raise ValueError(f"dumpState() расходится с dump() вне истории: {bad}")
        for sig, key, member in (("closedPids(uint256,uint256)", "closed_pids", "isClosedPid(bytes32)"),
                                 ("ledgerRefs(uint256,uint256)", "ledger_refs", "isLedgerRef(bytes32)")):
            full = st[key]; cut = len(full) // 2
            got = []
            for lo, n in ((0, cut), (cut, U256 - 1)):
                total, page = dec_page(self.call(sig, ["uint256", "uint256"], [lo, n]))
                if total != len(full):
                    raise ValueError(f"{sig}: всего {total}, а в выгрузке {len(full)}")
                got += [un_id32(x) for x in page]
            if got != full:
                raise ValueError(f"{sig}: страницы {got[:4]}… не равны списку выгрузки {full[:4]}…")
            total, page = dec_page(self.call(sig, ["uint256", "uint256"], [len(full) + 1, 5]))
            if (total, page) != (len(full), []):
                raise ValueError(f"{sig}: from за концом — ({total}, {len(page)} записей), а не пустая страница")
            probes = [(full[-1], True)] if full else []
            probes.append(("~never-used~", False))
            if key == "closed_pids":
                probes += [(pid, False) for pid, o in st["orders"].items() if o[1] != ORDER_STATE["closed"]][:1]
            for x, want_in in probes:
                if bool(dec_fixed(self.call(member, ["bytes32"], [id32(x)]), 1)[0]) != want_in:
                    raise ValueError(f"{member}({x!r}) != {want_in}")


    def views(self, addr) -> dict:
        out = {"addr": addr}
        raw = self.try_call("investorView(address)", ["address"], [addr])
        # `isInvestor` (O(1), им хранилище решает «первый ли депозит») обязан совпасть с «витрина инвестора есть» эталона
        is_inv = bool(dec_fixed(self.call("isInvestor(address)", ["address"], [addr]), 1)[0])
        if is_inv != (raw is not None):
            raise ValueError(f"isInvestor({addr}) = {is_inv}, а витрина инвестора {'есть' if raw is not None else 'отказала'}")
        if raw is None:
            out["investor"] = None
        elif self.frozen:                               # ред. 9.4: вывода нет — витрина эталона показывает долю снимка
            v = dec_fixed(raw, 3)
            out["investor"] = {"deposited": v[0], "withdrawn": v[1], "value": v[2], "safe_now": 0, "emergency_planes":
                               dec_fixed(self.call("emergencyPlanes(address)", ["address"], [addr]), 3)}
        else:
            v = ABI.dec_fixed(raw, 11)
            names = ("deposited", "withdrawn", "value", "net_profit", "claimable", "claimable_now", "queued",
                     "to_next_fee", "participation_bps", "payout_mode", "pool_shortfall")
            inv = dict(zip(names, v)); inv["payout_mode"] = bool(inv["payout_mode"])
            free = ABI.signed(self.call("freeStake(address,bool)", ["address", "bool"], [addr, False]))
            if free:
                paid = self.try_call("withdraw(address,uint256,bool)", ["address", "uint256", "bool"], [addr, free, False])
                w = None if paid is None else dec_fixed(paid, 3)
                if w is None or w[0] != 0:
                    raise ValueError(f"safe_now: вывод свободных {free} на копии отклонён у {addr} (код {w and w[0]})")
                inv["safe_now"] = w[1]
            else:
                inv["safe_now"] = 0
            out["investor"] = inv
        r = ABI.dec_fixed(self.call("referrerView(address)", ["address"], [addr]), 6)
        out["referrer"] = dict(zip(("reward", "reward_queued", "reward_claimable", "reward_claimable_now",
                                    "reward_withdrawn", "invited"), r))
        return out


# --- эталонное состояние в той же нормальной форме ---------------------------------------------------------- #
def norm_ref(s: dict) -> dict:
    """Нормальная форма эталона — владелец `pool_ledger_dump.norm_ref` (шесть слов ордера: `part_R`, снимок `emergency`)."""
    return DUMP.norm_ref(s, order_words=ORDER_WORDS)


def norm_view(v):
    if v is None:
        return None
    return {k: (x if isinstance(x, bool) or x is None else [int(y) for y in x] if isinstance(x, list) else int(x))
            for k, x in v.items()}


def diff(a, b, path="") -> list:
    """Расхождения двух нормальных форм: путь поля и оба значения."""
    if isinstance(a, dict) and isinstance(b, dict):
        out = []
        for k in sorted(set(a) | set(b), key=str):
            if k not in a or k not in b:
                out.append(f"{path}/{k}: эталон {a.get(k, '<нет>')!r} контракт {b.get(k, '<нет>')!r}")
            else:
                out += diff(a[k], b[k], f"{path}/{k}")
        return out
    return [] if a == b else [f"{path}: эталон {a!r} контракт {b!r}"]


def run_fixture(art: dict, path, verbose: bool, paged: bool = False) -> list:
    """Одна фикстура (файл или уже собранный словарь — `fuzz`) на своей цепи; расхождения — список строк (пусто — совпало).
    Отказ служебного вызова посреди расчёта (пул заперт) — тоже расхождение с номером вызова, а не падение прогона."""
    d = path if isinstance(path, dict) else json.load(open(path, encoding="utf-8"))
    if d.get("schema") != FIXTURE_SCHEMA:
        raise ValueError(f"{path}: схема {d.get('schema')!r}, дифференциал судит {FIXTURE_SCHEMA}")
    chain = Chain()
    try:
        L = Ledger(chain, art, d["constants"], paged)
        for k, (c, t) in enumerate(zip(d["calls"], d["trace"])):
            try:
                ok = L.apply(c)
            except (ValueError, RpcError) as e:
                return [f"вызов {k} {c['call']}: {e}"]
            if ok != t["accepted"]:
                return [f"вызов {k} {c}: эталон accepted={t['accepted']}, контракт {ok}"]
            if "result" in t and ok and int(t["result"]) != L.result:      # ред. 9.4: строка вызова с результатом
                return [f"вызов {k} {c}: результат эталон {t['result']}, контракт {L.result}"]
            try:
                got_state = L.state()
            except (ValueError, RpcError) as e:                # выгрузка отказала или разошлась раскладка — это расхождение
                return [f"вызов {k} {c['call']}: выгрузка состояния: {e}"]
            bad = diff(norm_ref(t["state"]), got_state)
            if bad:
                return [f"вызов {k} {c['call']}: {x}" for x in bad[:12]]
            if t.get("view"):
                vref = t["view"]
                try:
                    got = L.views(vref["addr"])
                except (ValueError, RpcError) as e:          # витрина отказала там, где эталон её посчитал, — расхождение
                    return [f"вызов {k} {c['call']} витрина {vref['addr']}: {e}"]
                bad = diff({"investor": norm_view(vref.get("investor")), "referrer": norm_view(vref.get("referrer"))},
                           {"investor": got["investor"], "referrer": got["referrer"]})
                if bad:
                    return [f"вызов {k} {c['call']} витрина {vref['addr']}: {x}" for x in bad[:12]]
            if verbose:
                print(f"  {k:4d} {c['call']:<16} accepted={ok}")
        fin = d.get("expected_final_views") or {}
        for a, vref in fin.items():
            try:
                got = L.views(a)
            except (ValueError, RpcError) as e:
                return [f"финальная витрина {a}: {e}"]
            bad = diff({"investor": norm_view(vref.get("investor")), "referrer": norm_view(vref.get("referrer"))},
                       {"investor": got["investor"], "referrer": got["referrer"]})
            if bad:
                return [f"финальная витрина {a}: {x}" for x in bad[:12]]
        return []
    finally:
        chain.close()


def build():
    r = subprocess.run([foundry("forge"), "build", "--no-lint"], cwd=CONTRACTS, capture_output=True, text=True, encoding="utf-8")
    if r.returncode != 0:
        raise ValueError(f"forge build: {r.stdout[-2000:]}{r.stderr[-2000:]}")
    for path in (ARTIFACT, VIEWS_ARTIFACT, MONDAY_ARTIFACT, PROJ_ARTIFACT, EMERGENCY_ARTIFACT, VAULT_ARTIFACT, LEG_ARTIFACT,
                 VAULT_EM_ARTIFACT, BOOK_ARTIFACT):
        if not os.path.isfile(path):
            raise ValueError(f"нет артефакта {path}")
    art = json.load(open(ARTIFACT, encoding="utf-8"))
    art["views"] = json.load(open(VIEWS_ARTIFACT, encoding="utf-8"))
    art["monday"] = json.load(open(MONDAY_ARTIFACT, encoding="utf-8"))
    art["proj"] = json.load(open(PROJ_ARTIFACT, encoding="utf-8"))
    art["emergency"] = json.load(open(EMERGENCY_ARTIFACT, encoding="utf-8"))
    art["book"] = json.load(open(BOOK_ARTIFACT, encoding="utf-8"))
    art["vault"] = json.load(open(VAULT_ARTIFACT, encoding="utf-8"))
    art["leg"] = json.load(open(LEG_ARTIFACT, encoding="utf-8"))
    art["vault_em"] = json.load(open(VAULT_EM_ARTIFACT, encoding="utf-8"))
    views_abi_only_reads(art["views"])
    views_abi_only_reads(art["proj"], "PoolLedgerProj")
    return art


def views_abi_only_reads(views: dict, name: str = "PoolLedgerViews"):
    """PoolLedgerViews и PoolLedgerProj исполняются через fallback (delegatecall) НА ПАМЯТИ PoolLedger. Изменяющая функция
    там стала бы записью в бухгалтерию в обход всех правил — поэтому в их ABI допустимы только view/pure. Отказ —
    ValueError с именем."""
    bad = [f["name"] for f in views["abi"] if f.get("type") == "function" and f.get("stateMutability") not in ("view", "pure")]
    if bad:
        raise ValueError(f"{name}: изменяющие функции {bad} — через delegatecall они писали бы в память бухгалтерии")


def layout_of(name: str) -> tuple:
    """([(имя, слот, смещение, тип)], таблица типов) — `forge inspect <name> storageLayout`."""
    r = subprocess.run([foundry("forge"), "inspect", name, "storageLayout", "--json"], cwd=CONTRACTS, capture_output=True,
                       text=True, encoding="utf-8", env=dict(os.environ, FOUNDRY_LINT_LINT_ON_BUILD="false"))
    if r.returncode != 0:
        raise ValueError(f"forge inspect {name} storageLayout: {r.stderr[-800:]}")
    d = json.loads(r.stdout)
    # поле `contract` у полей структур называет НАСЛЕДНИКА, а не раскладку — сравнивается всё, кроме него
    types = {k: dict(t, members=[{f: m[f] for f in m if f != "contract"} for m in t["members"]]) if "members" in t else t
             for k, t in d["types"].items()}
    return [(v["label"], v["slot"], v["offset"], v["type"]) for v in d["storage"]], types


def layout_mismatch(base: tuple, got: tuple):
    """None — раскладки равны переменная к переменной и по таблице типов; иначе — первые расхождения строкой."""
    if got == base:
        return None
    bad = [f"{a} != {b}" for a, b in zip(base[0], got[0]) if a != b][:3]
    if len(base[0]) != len(got[0]):
        bad.append(f"переменных {len(base[0])} против {len(got[0])}")
    return "; ".join(bad) or "таблица типов"


def storage_layout() -> dict:
    """Раскладка памяти бухгалтерии: у каждой из LEDGER_PARTS — та же, что у PoolLedger. Реализация с иной раскладкой
    писала бы делегированным вызовом в ЧУЖИЕ слоты PoolLedger. Ответ — {имя: слот}; расхождение — ValueError с именем."""
    base = layout_of(LEDGER_PARTS[0])
    if not base[0]:
        raise ValueError(f"{LEDGER_PARTS[0]}: пустая раскладка памяти")
    for name in LEDGER_PARTS[1:]:
        why = layout_mismatch(base, layout_of(name))
        if why:
            raise ValueError(f"раскладка памяти {name} не равна {LEDGER_PARTS[0]}: {why}")
    return {label: int(slot) for label, slot, _, _ in base[0]}


def code_sizes(art: dict) -> dict:
    """{контракт: (runtime, initcode)} в байтах по артефактам; за пределами EIP-170 / EIP-3860 — ValueError."""
    out = {}
    for key, name in (("", "PoolLedger"), ("views", "PoolLedgerViews"), ("monday", "PoolLedgerMonday"), ("proj", "PoolLedgerProj"),
                      ("emergency", "PoolLedgerEmergency"), ("book", "PoolLedgerBook"), ("vault", "PoolVault"),
                      ("leg", "TradingLeg"), ("vault_em", "PoolVaultEmergency")):
        a = art[key] if key else art
        rt = (len(a["deployedBytecode"]["object"]) - 2) // 2
        ic = (len(a["bytecode"]["object"]) - 2) // 2
        if rt > EIP170 or ic > EIP3860:
            raise ValueError(f"{name}: runtime {rt} (EIP-170 {EIP170}), initcode {ic} (EIP-3860 {EIP3860})")
        out[name] = (rt, ic)
    return out


def create_address(sender: str, nonce: int) -> str:
    """Адрес CREATE (`sender`, `nonce`) — `cast compute-address` (keccak в stdlib нет)."""
    r = subprocess.run([foundry("cast"), "compute-address", "--nonce", str(nonce), sender], capture_output=True, text=True)
    out = r.stdout.strip().split()[-1] if r.returncode == 0 and r.stdout.strip() else ""
    if not (out.startswith("0x") and len(out) == 42):
        raise ValueError(f"cast compute-address: {r.stdout[-300:]}{r.stderr[-300:]}")
    return out.lower()


def deploy_code(chain: "Chain", data: str, what: str) -> str:
    """Одна транзакция создания с ключа цепи; отказ (размер кода, конструктор) — ValueError с именем."""
    h = chain.rpc("eth_sendTransaction", {"from": chain.me, "data": data, "gas": hex(GAS)})
    rc = chain.receipt(h)
    if int(rc["status"], 16) != 1 or not rc.get("contractAddress"):
        raise ValueError(f"деплой {what} не прошёл (конструктор или размер кода: EIP-170 / EIP-3860)")
    return rc["contractAddress"].lower()


def max_investors_bound() -> int:
    """`MAX_INVESTORS_BOUND` контракта — из ЕГО исходника (второго числа не заводится): `max_investors = None` эталона
    («предела нет») контракт выражает этой границей."""
    m = re.findall(r"uint256 internal constant MAX_INVESTORS_BOUND = (\d+);", open(SOURCE, encoding="utf-8").read())
    if len(m) != 1:
        raise ValueError(f"MAX_INVESTORS_BOUND в {SOURCE}: найдено {len(m)} определений")
    return int(m[0])


def ledger_limits(constants: dict) -> tuple:
    """(минимум депозита, предел адресов) конструктора из `constants` фикстуры v9; null предела — граница контракта."""
    mi = constants["max_investors"]
    return int(constants["min_deposit"]), max_investors_bound() if mi is None else int(mi)


def max_gens_of(constants: dict) -> int:
    """Предел поколений конструктора (ред. 9.5): `max_gens` из `constants` (фикстура 266, параметры деплоя); нет ключа или
    null — 0, «правила нет» (эталон None)."""
    return int(constants.get("max_gens") or 0)


def ledger_ctor(constants: dict, views: str, monday: str, proj: str, emergency: str, owner: str, book: str) -> bytes:
    return encode(["address"] + ["uint256"] * 8 + ["address"] * 6 + ["uint256"],
                  [constants["treasury"], int(constants["buffer_bps"]), int(constants["fee_bps"]),
                   int(constants["ref_share_bps"]), int(constants["hold_bps"]), int(constants["open_ref_share_bps"]),
                   int(constants["partner_term_weeks"]), *ledger_limits(constants), views, monday, proj, emergency, owner,
                   book, max_gens_of(constants)])


def deploy_pool(chain: "Chain", art: dict, constants: dict, roles: dict, burn_nonce: bool = False) -> dict:
    """ДЕПЛОЙ ПУЛА ПО КЕ10 с одного ключа, ПОДРЯД: реализации бухгалтерии (их пять, с PoolLedgerEmergency), затем бухгалтерия
    и обе ноги на ВЫЧИСЛЕННЫЙ адрес хранилища (CREATE деплойера, nonce через четыре создания), модуль аварии хранилища
    PoolVaultEmergency (ред. 9.4), затем само хранилище — оно сверяет связность конструктором.
    Ответ — манифест (адреса, nonce, codehash каждой части, параметры). `burn_nonce` — стенд: перед хранилищем деплойер
    тратит nonce на другое, и конструктор хранилища обязан отказать (по вычисленному адресу встаёт не оно)."""
    parts = {name: deploy_code(chain, art[key]["bytecode"]["object"], name)
             for key, name in (("views", "PoolLedgerViews"), ("monday", "PoolLedgerMonday"), ("proj", "PoolLedgerProj"),
                               ("emergency", "PoolLedgerEmergency"), ("book", "PoolLedgerBook"))}
    n = int(chain.rpc("eth_getTransactionCount", chain.me, "latest"), 16)
    vault = create_address(chain.me, n + 4)
    parts["PoolLedger"] = deploy_code(chain, art["bytecode"]["object"] + ledger_ctor(
        constants, parts["PoolLedgerViews"], parts["PoolLedgerMonday"], parts["PoolLedgerProj"], parts["PoolLedgerEmergency"],
        vault, parts["PoolLedgerBook"]).hex(), "PoolLedger")
    for leg in ("TradingLegA", "TradingLegB"):
        parts[leg] = deploy_code(chain, art["leg"]["bytecode"]["object"] + encode(["address"], [vault]).hex(), leg)
    if burn_nonce:
        chain.receipt(chain.rpc("eth_sendTransaction", {"from": chain.me, "to": chain.me, "value": "0x0"}))
    # ред. 9.4: модуль аварии хранилища — до хранилища (его адрес — immutable хранилища); зависимостей у него нет, сроки
    # триггеров — аргументы конструктора (параметры деплоя), их сверяет с DELAY конструктор хранилища
    parts["PoolVaultEmergency"] = deploy_code(chain, art["vault_em"]["bytecode"]["object"] + encode(
        ["uint256"] * len(EM_TERMS), [int(roles["terms"][k]) for k in EM_TERMS]).hex(), "PoolVaultEmergency")
    # порядок полей VaultInit: ledger, legA, legB, admin, keeper, guardian, delay, tvlCap, legShareBps (C7), emergency (9.4)
    init = encode(["address"] * 6 + ["uint256"] * 3 + ["address"],
                  [parts["PoolLedger"], parts["TradingLegA"], parts["TradingLegB"], roles["admin"], roles["keeper"],
                   roles["guardian"], int(roles["delay"]), int(roles["tvl_cap"]), int(roles["leg_share_bps"]),
                   parts["PoolVaultEmergency"]])
    parts["PoolVault"] = deploy_code(chain, art["vault"]["bytecode"]["object"] + init.hex(), "PoolVault")
    if parts["PoolVault"] != vault:
        raise ValueError(f"хранилище встало на {parts['PoolVault']}, а не на вычисленный {vault}")
    return {"schema": MANIFEST_SCHEMA, "chain_id": int(chain.rpc("eth_chainId"), 16), "deployer": chain.me.lower(),
            "vault_nonce": n + 4,
            "constants": {k: constants[k] for k in ("treasury", "buffer_bps", "fee_bps", "ref_share_bps", "hold_bps",
                                                    "open_ref_share_bps", "partner_term_weeks", "min_deposit", "max_investors",
                                                    "max_gens")},
            "roles": dict(roles),
            "parts": {k: {"address": a, "codehash": code_hash(chain, a)}
                      for k, a in parts.items()}}


def keccak_hex(data: bytes) -> str:
    """keccak256 байтов — `cast keccak` со stdin (keccak в stdlib нет; код части — десятки КБ, аргументом командной строки
    Windows его не передать)."""
    r = subprocess.run([foundry("cast"), "keccak"], input="0x" + data.hex(), capture_output=True, text=True)
    out = r.stdout.strip()
    if r.returncode != 0 or not (out.startswith("0x") and len(out) == 66):
        raise ValueError(f"cast keccak: {r.stdout[-300:]}{r.stderr[-300:]}")
    return out.lower()


def code_hash(chain, addr: str) -> str:
    """codehash части = keccak256 её кода (`eth_getCode`): то же, что `codeHash` аккаунта, но без `eth_getProof` — его RPC
    боевой цепи может не отдавать (проверка после деплоя читает только `eth_chainId`/`eth_getCode`/`eth_call`/
    `eth_getStorageAt`)."""
    return keccak_hex(bytes.fromhex(chain.rpc("eth_getCode", addr, "latest")[2:]))


def _masked(code: bytes, refs: dict) -> tuple:
    """(код с обнулёнными immutable, [значения immutable по возрастанию]); у одного immutable во всех местах значение одно."""
    b = bytearray(code); vals = []
    for ranges in refs.values():
        words = {bytes(code[r["start"]: r["start"] + r["length"]]) for r in ranges}
        if len(words) != 1:
            raise ValueError(f"immutable в {len(ranges)} местах кода несёт {len(words)} разных значений")
        vals.append(int.from_bytes(words.pop(), "big"))
        for r in ranges:
            b[r["start"]: r["start"] + r["length"]] = bytes(r["length"])
    return bytes(b), sorted(vals)


def postdeploy_check(chain: "Chain", manifest: dict, art: dict) -> list:
    """ПРОВЕРКА ПОСЛЕ ДЕПЛОЯ (КЕ10, В12 плана доверия): пусто — пул собран верно; иначе — расхождения с именем части.
    Судится: (1) codehash каждой части на цепи = манифесту; (2) код каждой части = коду сборки байт в байт, у частей с
    immutable — с обнулёнными immutable, а сами immutable = ожидаемым адресам и сроку; (3) владелец бухгалтерии (слот
    раскладки) и хранилище каждой ноги — ровно хранилище манифеста, у хранилища — ровно эти бухгалтерия, ноги и роли;
    (4) адреса реализаций в памяти бухгалтерии = манифесту; (5) раскладка памяти всех реализаций одна (`storage_layout`);
    (6) состояние и параметры, а не только код (ревью 20.10, п. 7) — `postdeploy_state`: chain-id, `params()`, `initialized`,
    пустые предложения таймлока, сроки модуля аварии по имени, активация хранилища и ног с долей на Core."""
    if manifest.get("schema") != MANIFEST_SCHEMA:
        return [f"манифест: схема {manifest.get('schema')!r}, проверка судит {MANIFEST_SCHEMA}"]
    arts = {"PoolLedger": art, "PoolLedgerViews": art["views"], "PoolLedgerMonday": art["monday"], "PoolLedgerProj": art["proj"],
            "PoolLedgerEmergency": art["emergency"], "PoolLedgerBook": art["book"], "PoolVault": art["vault"],
            "TradingLegA": art["leg"],
            "TradingLegB": art["leg"], "PoolVaultEmergency": art["vault_em"]}
    missing = set(arts) - set(manifest["parts"])
    if missing:
        return [f"манифест: нет частей {sorted(missing)}"]
    P = {k: v["address"].lower() for k, v in manifest["parts"].items()}
    bad = []
    if P["TradingLegA"] == P["TradingLegB"]:
        bad.append("ноги A и B — один адрес")
    word = lambda a: int(a, 16)
    expect_imm = {"PoolVault": sorted([word(P["PoolLedger"]), word(P["TradingLegA"]), word(P["TradingLegB"]),
                                       int(manifest["roles"]["delay"]), word(P["PoolVaultEmergency"])]),
                  "TradingLegA": [word(P["PoolVault"])], "TradingLegB": [word(P["PoolVault"])],
                  # сроки триггеров аварии — immutable модуля = параметрам манифеста
                  "PoolVaultEmergency": sorted(int(manifest["roles"]["terms"][k]) for k in EM_TERMS)}
    for name, a in arts.items():
        got = bytes.fromhex(chain.rpc("eth_getCode", P[name], "latest")[2:])
        if not got:
            bad.append(f"{name}: по адресу {P[name]} нет кода"); continue
        ch = keccak_hex(got)
        if ch != manifest["parts"][name]["codehash"]:
            bad.append(f"{name}: codehash {ch} против манифеста {manifest['parts'][name]['codehash']}")
        want = bytes.fromhex(a["deployedBytecode"]["object"][2:])
        refs = a["deployedBytecode"].get("immutableReferences") or {}
        if len(got) != len(want):
            bad.append(f"{name}: код {len(got)} байт против {len(want)} у сборки"); continue
        try:
            mg, vals = _masked(got, refs)
        except ValueError as e:
            bad.append(f"{name}: {e}"); continue
        if mg != _masked(want, refs)[0]:
            bad.append(f"{name}: код не равен коду сборки")
        if vals != expect_imm.get(name, []):
            bad.append(f"{name}: immutable {[hex(v) for v in vals]} против {[hex(v) for v in expect_imm.get(name, [])]}")
    slots = storage_layout()

    def slot_addr(label):
        return "0x" + chain.rpc("eth_getStorageAt", P["PoolLedger"], hex(slots[label]), "latest")[-40:]
    for label, part in (("owner", "PoolVault"), ("viewsImpl", "PoolLedgerViews"), ("mondayImpl", "PoolLedgerMonday"),
                        ("projImpl", "PoolLedgerProj"), ("emergencyImpl", "PoolLedgerEmergency"), ("bookImpl", "PoolLedgerBook")):
        got = slot_addr(label)
        if got != P[part]:
            bad.append(f"PoolLedger.{label} = {got}, а не {part} {P[part]}")

    def getter(addr, a, sig):
        return "0x" + chain.rpc("eth_call", {"to": addr, "data": "0x" + a["methodIdentifiers"][sig]}, "latest")[-40:]
    lim = dec_fixed(bytes.fromhex(chain.rpc("eth_call", {"to": P["PoolLedger"], "data": "0x" + art["views"]["methodIdentifiers"]["limits()"]},
                                            "latest")[2:]), 2)
    if tuple(lim) != ledger_limits(manifest["constants"]):
        bad.append(f"PoolLedger.limits() = {lim}, а не {ledger_limits(manifest['constants'])} манифеста")
    # ред. 9.5: предел поколений = манифесту и задан (0 — «правила нет»: внеочередной расчёт без условия, поколений без предела)
    mg = _call_words(chain, P["PoolLedger"], art["views"], "genLimits()", 3)[0]
    if mg != max_gens_of(manifest["constants"]) or mg == 0:
        bad.append(f"PoolLedger.genLimits().maxGens = {mg}, а не {manifest['constants'].get('max_gens')} манифеста (или 0 — "
                   f"предела нет)")
    for leg in ("TradingLegA", "TradingLegB"):
        if getter(P[leg], art["leg"], "vault()") != P["PoolVault"]:
            bad.append(f"{leg}.vault() — не хранилище манифеста")
    for sig, part in (("ledger()", "PoolLedger"), ("legA()", "TradingLegA"), ("legB()", "TradingLegB"),
                      ("emergency()", "PoolVaultEmergency")):
        if getter(P["PoolVault"], art["vault"], sig) != P[part]:
            bad.append(f"PoolVault.{sig} — не {part} манифеста")
    for sig, key in (("admin()", "admin"), ("keeper()", "keeper"), ("guardian()", "guardian")):
        if getter(P["PoolVault"], art["vault"], sig) != manifest["roles"][key].lower():
            bad.append(f"PoolVault.{sig} — не {key} манифеста")
    for sig, key in (("tvlCap()", "tvl_cap"), ("legShareBps()", "leg_share_bps")):
        got = int(chain.rpc("eth_call", {"to": P["PoolVault"], "data": "0x" + art["vault"]["methodIdentifiers"][sig]}, "latest"), 16)
        if got != int(manifest["roles"][key]):
            bad.append(f"PoolVault.{sig} = {got}, а не {key} манифеста {manifest['roles'][key]}")
    return bad + postdeploy_state(chain, manifest, art, P)


def _call_words(chain: "Chain", to: str, a: dict, sig: str, n: int, args: bytes = b"") -> list:
    """`eth_call` функции `sig` по ABI артефакта `a`: `n` слов ответа (знаковые, как `dec_fixed`)."""
    out = chain.rpc("eth_call", {"to": to, "data": "0x" + a["methodIdentifiers"][sig] + args.hex()}, "latest")
    return dec_fixed(bytes.fromhex(out[2:]), n)


def core_user_exists(chain: "Chain", addr: str) -> bool:
    """Прекомпайл Core `coreUserExists` (тот же вызов, что `PrecompileLib.coreUserExists`: `abi.encode(user)` без
    селектора). Цепь без прекомпайла (пустой ответ) — ValueError: «не на Core» и «спросить нечем» — разные исходы."""
    out = chain.rpc("eth_call", {"to": CORE_USER_EXISTS, "data": "0x" + encode(["address"], [addr]).hex()}, "latest")
    if len(out) != 66:
        raise ValueError(f"прекомпайл {CORE_USER_EXISTS} не ответил ({out!r}) — цепь без HyperCore")
    return int(out, 16) != 0


def timelock_kinds() -> list:
    """Виды таймлока хранилища — 0..наибольший `P_*` исходников (`PoolVault.sol` и модуль аварии; второго перечня не
    заводится). Промежуточные номера (4 — agent-ключ ноги B, `P_AGENT + 1`) входят диапазоном."""
    vals = [int(v) for src in (VAULT_SOURCE, VAULT_EM_SOURCE)
            for v in re.findall(r"uint256 (?:internal )?constant P_[A-Z]+ = (\d+);", open(src, encoding="utf-8").read())]
    if not vals:
        raise ValueError("виды таймлока не найдены в исходниках хранилища")
    return list(range(max(vals) + 1))


def postdeploy_state(chain: "Chain", manifest: dict, art: dict, P: dict) -> list:
    """Ревью 20.10, п. 7 — что проверка после деплоя судила не всё: (1) chain-id манифеста = цепи; (2) параметры
    бухгалтерии `params()` (owner, treasury и шесть чисел) = манифесту; (3) бухгалтерия не тронута (`initialized` = 0 —
    его ставит первая же изменяющая операция); (4) ни одного висящего предложения таймлока; (5) сроки модуля аварии ПО
    ИМЕНИ (сверка immutable — по отсортированному набору и перестановку сроков не видит); (6) хранилище и
    каждая нога с долей в раздаче — на Core (нога с долей 0 не обязана: C7). Ревью-2, #5 / H1: `DELAY` цепи = манифесту и не
    короче `MIN_DELAY` исходника, каждый срок >= 2·DELAY, `T_QUEUE_MAX` >= выведенной границы (`queue_max_floor`). Пусто —
    чисто."""
    bad = []
    cid = int(chain.rpc("eth_chainId"), 16)
    if manifest.get("chain_id") != cid:
        bad.append(f"chain_id манифеста {manifest.get('chain_id')} — не цепь {cid}")
    c = manifest["constants"]
    pv = _call_words(chain, P["PoolLedger"], art["views"], "params()", 8)
    got = {"owner": addr_of(pv[0]), "treasury": addr_of(pv[1]), "buffer_bps": pv[2], "fee_bps": pv[3],
           "ref_share_bps": pv[4], "hold_bps": pv[5], "open_ref_share_bps": pv[6], "partner_term_weeks": pv[7]}
    want = {"owner": P["PoolVault"], "treasury": str(c["treasury"]).lower(),
            **{k: int(c[k]) for k in ("buffer_bps", "fee_bps", "ref_share_bps", "hold_bps", "open_ref_share_bps",
                                      "partner_term_weeks")}}
    bad += [f"PoolLedger.params().{k} = {got[k]}, а не {want[k]} манифеста" for k in want if got[k] != want[k]]
    if _call_words(chain, P["PoolLedger"], art["views"], "status()", 13)[0] != 0:
        bad.append("PoolLedger.status().initialized = 1: бухгалтерию уже меняли после деплоя")
    for k in timelock_kinds():
        h = _call_words(chain, P["PoolVault"], art["vault"], "proposals(uint256)", 2, encode(["uint256"], [k]))[0]
        if h != 0:
            bad.append(f"PoolVault.proposals({k}) не пусто: висит предложение таймлока")
    delay = _call_words(chain, P["PoolVault"], art["vault"], "DELAY()", 1)[0]
    if delay != int(manifest["roles"]["delay"]):
        bad.append(f"PoolVault.DELAY() = {delay}, а не delay манифеста {manifest['roles']['delay']}")
    if delay < min_delay():
        bad.append(f"PoolVault.DELAY() = {delay} короче MIN_DELAY {min_delay()}")
    for k in EM_TERMS:
        t = _call_words(chain, P["PoolVaultEmergency"], art["vault_em"], f"{k.upper()}()", 1)[0]
        if t != int(manifest["roles"]["terms"][k]):
            bad.append(f"PoolVaultEmergency.{k.upper()}() = {t}, а не {k} манифеста {manifest['roles']['terms'][k]}")
        if t < 2 * delay:
            bad.append(f"PoolVaultEmergency.{k.upper()}() = {t} короче 2·DELAY {2 * delay}")
    # ревью-2, H1: нога закрывает каждую позицию по календарю не позже `profit_target_force_close_d`, затем недельный расчёт —
    # срок очереди обязан это пережить с запасом на окна keeper'а; нижняя граница выводится, а не задаётся числом
    floor, why = queue_max_floor(manifest["roles"])
    t = _call_words(chain, P["PoolVaultEmergency"], art["vault_em"], "T_QUEUE_MAX()", 1)[0]
    if t < floor:
        bad.append(f"PoolVaultEmergency.T_QUEUE_MAX() = {t} короче выведенной границы {floor} ({why})")
    share = int(manifest["roles"]["leg_share_bps"])
    need = [("PoolVault", True), ("TradingLegA", share > 0), ("TradingLegB", share < BPS)]
    for part, must in need:
        if not must:
            continue
        try:
            if not core_user_exists(chain, P[part]):
                bad.append(f"{part} {P[part]} не активирован на Core (coreUserExists = false)")
        except ValueError as e:
            bad.append(f"{part}: активацию на Core проверить нечем — {e}")
    return bad


# сроки триггеров аварии (ред. 9.4) — аргументы конструктора PoolVaultEmergency в этом порядке
EM_TERMS = ("t_stuck", "t_dead", "t_nomonday", "t_serve", "t_queue_max")
# Параметры беты — ЕДИНСТВЕННЫЙ источник чисел репетиции (второго набора сроков в коде нет): `deploy/params.beta.json`.
PARAMS_BETA = os.path.join(CONTRACTS, "deploy", "params.beta.json")
PARAMS_SCHEMA = "pool_deploy_params_v1"
# адреса ролей и treasury репетиции (в файле параметров — плейсхолдеры `<…>`; ключей и адресов там нет)
REHEARSAL_ADDR = {"admin": "0x" + "a1" * 20, "keeper": "0x" + "b2" * 20, "guardian": "0x" + "c3" * 20,
                  "treasury": "0x" + "0" * 37 + "fee"}
DAY_S = 24 * 3600


def config_number(ref: str) -> float:
    """`файл:ключ.ключ` от корня репозитория — число у ВЛАДЕЛЬЦА (`config/operational_limits.json`), а не копия."""
    path, keys = ref.split(":", 1)
    v = json.load(open(os.path.join(ROOT, path), encoding="utf-8"))
    for k in keys.split("."):
        if not isinstance(v, dict) or k not in v:
            raise ValueError(f"{ref}: нет ключа {k}")
        v = v[k]
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        raise ValueError(f"{ref}: не число ({v!r})")
    return v


def min_delay() -> int:
    """`MIN_DELAY` хранилища — из ЕГО исходника (второго числа не заводится)."""
    m = re.findall(r"uint256 internal constant MIN_DELAY = (\d+) hours;", open(VAULT_SOURCE, encoding="utf-8").read())
    if len(m) != 1:
        raise ValueError(f"MIN_DELAY в {VAULT_SOURCE}: найдено {len(m)} определений")
    return int(m[0]) * 3600


def queue_max_floor(roles: dict) -> tuple:
    """Нижняя граница `T_QUEUE_MAX` (ревью-2, H1/H1b): (принудительное закрытие позиции ногой по календарю + период расчёта)
    в сутках + запас на окна keeper'а. Первое слагаемое — у владельца (`config/operational_limits.json`), остальное — поля
    `queue_floor` параметров / манифеста. Ответ — (секунды, вывод строкой)."""
    q = roles.get("queue_floor")
    if not isinstance(q, dict) or set(q) != {"force_close_source", "settle_d", "keeper_margin_s"}:
        raise ValueError(f"queue_floor: ждали force_close_source, settle_d, keeper_margin_s — есть {q!r}")
    fc = config_number(q["force_close_source"])
    if fc <= 0 or int(fc) != fc or int(q["settle_d"]) <= 0 or int(q["keeper_margin_s"]) < 0:
        raise ValueError(f"queue_floor: негодные слагаемые {fc}, {q['settle_d']}, {q['keeper_margin_s']}")
    floor = (int(fc) + int(q["settle_d"])) * DAY_S + int(q["keeper_margin_s"])
    return floor, f"{int(fc)} сут закрытия + {int(q['settle_d'])} сут расчёта + {int(q['keeper_margin_s'])} с запаса"


def load_params(path: str = PARAMS_BETA) -> dict:
    """Файл параметров деплоя: схема, роли-плейсхолдеры, числа хранилища и сроки, вывод границы очереди, константы
    бухгалтерии (TBD — решение оператора; ссылка `файл:ключ` — число владельца, `hold_bps` = катастрофический стоп × BPS).
    Ответ — {"roles": ..., "constants": ..., "tbd": [...]}; негодное — ValueError с именем."""
    d = json.load(open(path, encoding="utf-8"))
    if d.get("schema") != PARAMS_SCHEMA:
        raise ValueError(f"{path}: схема {d.get('schema')!r}, ждали {PARAMS_SCHEMA}")
    v, t, led = d["vault"], d["terms"], d["ledger"]
    if set(t) != set(EM_TERMS):
        raise ValueError(f"{path}: сроки {sorted(t)} против {sorted(EM_TERMS)}")
    roles = dict(d["roles"], delay=int(v["delay"]), tvl_cap=int(v["tvl_cap"]), leg_share_bps=int(v["leg_share_bps"]),
                 terms={k: int(t[k]) for k in EM_TERMS}, queue_floor=dict(d["queue_floor"]))
    queue_max_floor(roles)                                      # вывод границы обязан считаться уже на файле
    tbd = []; const = {}
    for k in ("treasury", "min_deposit", "max_investors", "fee_bps", "ref_share_bps", "open_ref_share_bps", "hold_bps",
              "buffer_bps", "partner_term_weeks", "max_gens"):
        x = led[k]
        if x == "TBD":
            tbd.append(k); const[k] = None
        elif k == "hold_bps" and isinstance(x, str):
            const[k] = round(config_number(x) * BPS)
        else:
            const[k] = x
    const["partners"] = list(led["partners"])
    return {"roles": roles, "constants": const, "tbd": tbd}


def rehearsal_roles(params: dict = None) -> dict:
    """Роли и числа хранилища репетиции — из параметров беты, плейсхолдеры адресов — адресами репетиции."""
    r = json.loads(json.dumps((params or load_params())["roles"]))
    for k in ("admin", "keeper", "guardian"):
        if not str(r[k]).startswith("<"):
            raise ValueError(f"параметры: роль {k} — не плейсхолдер ({r[k]}): адресов ролей в файле параметров быть не должно")
        r[k] = REHEARSAL_ADDR[k]
    return r


def rehearsal_core(chain: "Chain", inactive: str = "0x" + "0" * 40):
    """Репетиция на anvil: HyperCore нет, и прекомпайл `coreUserExists` ставится заглушкой — «на Core» любой адрес, кроме
    `inactive` (стенд неактивированной части). На боевой цепи прекомпайл настоящий; без заглушки проверка после деплоя
    называет «проверить нечем», а не «чисто». Код: `return iszero(eq(calldataload(0), inactive))`."""
    code = "0x600035" + "73" + inactive[2:].lower() + "1415" + "600052" + "60206000f3"
    chain.rpc("anvil_setCode", CORE_USER_EXISTS, code)


def rehearsal_constants(params: dict = None) -> dict:
    """Параметры бухгалтерии репетиции — из параметров беты; поле `TBD` (ставки — решение оператора) — из первой фикстуры
    эталона (своих чисел не заводится), treasury-плейсхолдер — адресом репетиции. Ответ — в форме `constants` фикстуры."""
    P = params or load_params()
    c = dict(json.load(open(cases()[0][1], encoding="utf-8"))["constants"])
    for k, x in P["constants"].items():
        if k == "treasury":
            c[k] = REHEARSAL_ADDR["treasury"] if str(x).startswith("<") else x
        elif x is not None:
            c[k] = x if k == "partners" else str(x)
    return c


def cmd_rehearse(args) -> int:
    """Репетиция деплоя КЕ10 на своей цепи: порядок, манифест, проверка после деплоя, размеры. Сети не касается."""
    art = build()
    for name, (rt, ic) in code_sizes(art).items():
        print(f"  {name:18} runtime {rt:6} (запас EIP-170 {EIP170 - rt:6})  initcode {ic:6} (запас EIP-3860 {EIP3860 - ic:6})")
    params = load_params()
    print(f"  параметры: {os.path.relpath(PARAMS_BETA, ROOT)}; TBD (решение оператора, в репетиции — числа фикстуры): "
          f"{params['tbd'] or 'нет'}; граница T_QUEUE_MAX: {queue_max_floor(params['roles'])[1]}")
    chain = Chain()
    try:
        m = deploy_pool(chain, art, rehearsal_constants(params), rehearsal_roles(params))
        rehearsal_core(chain)
        bad = postdeploy_check(chain, m, art)
    finally:
        chain.close()
    if args.out:
        json.dump(m, open(args.out, "w", encoding="utf-8"), indent=1)
        print(f"  манифест: {args.out}")
    for x in bad:
        print("   ", x)
    print(f"REHEARSE: {'PASS' if not bad else 'FAIL'} (частей {len(m['parts'])}, хранилище — nonce {m['vault_nonce']})")
    return 1 if bad else 0


class RemoteChain:
    """Цепь по RPC-адресу — ТОЛЬКО ЧТЕНИЕ (ревью-2, #7): проверка после деплоя на боевой цепи. Методы — закрытый перечень
    `READ_ONLY` (`eth_chainId`, `eth_getCode`, `eth_call`, `eth_getStorageAt`); любой другой — ValueError ДО сети: ни
    отправки транзакций, ни подписи, ни ключей у класса нет. Запросы — с интервалом `spacing` секунд (публичный RPC HyperEVM
    ограничивает частоту; повторов нет — отказ RPC есть отказ проверки, fail-loud)."""
    READ_ONLY = ("eth_chainId", "eth_getCode", "eth_call", "eth_getStorageAt")

    def __init__(self, url: str, spacing: float):
        if not url.startswith(("http://", "https://")):
            raise ValueError(f"--rpc: ждали http(s)://…, а не {url!r}")
        if spacing < 0:
            raise ValueError(f"--spacing {spacing} < 0")
        self.url, self.spacing, self.last, self.calls = url, spacing, 0.0, []

    def rpc(self, method, *params):
        if method not in self.READ_ONLY:
            raise ValueError(f"RemoteChain: метод {method} вне перечня только-чтения {self.READ_ONLY}")
        import urllib.request
        wait = self.last + self.spacing - time.monotonic()
        if wait > 0:
            time.sleep(wait)
        body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": list(params)}).encode()
        req = urllib.request.Request(self.url, body, {"Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=60) as resp:
                out = json.loads(resp.read())
        finally:
            self.last = time.monotonic()
        self.calls.append(method)
        if "error" in out:
            raise RpcError(out["error"])
        return out["result"]


def cmd_postdeploy(args) -> int:
    """Проверка после деплоя ПО РЕАЛЬНОЙ ЦЕПИ (ревью-2, #7): тот же `postdeploy_check` (код частей против ЛОКАЛЬНОЙ сборки
    этого дерева, связность, `postdeploy_state`), что у репетиции, но цепь — RPC-адрес только для чтения (`RemoteChain`).
    Деплоя, подписи и ключей нет. rc 0 — чисто; иначе расхождения поимённо."""
    manifest = json.load(open(args.manifest, encoding="utf-8"))
    art = build()
    chain = RemoteChain(args.rpc, args.spacing)
    bad = postdeploy_check(chain, manifest, art)
    for x in bad:
        print("   ", x)
    print(f"POSTDEPLOY: {'PASS' if not bad else 'FAIL'} (цепь {manifest.get('chain_id')}, частей {len(manifest.get('parts', {}))}, "
          f"запросов RPC {len(chain.calls)}: {sorted(set(chain.calls))})")
    return 1 if bad else 0


# Фикстуры v9, которые дифференциал НЕ гонит, — поимённо и с причиной (не молча: `cases` отказывает, если такой файл
# исчез). Ред. 9.4 «замороженный пул» перенесена (PoolLedgerEmergency, правило E — `emergencyDue`): исключений нет, и
# selftest C17 судит, что фикстуры с вызовами аварии (236-239, 260, 261) — в прогоне.
EXCLUDED_FIXTURES = {}
EMERGENCY_CALLS = ("emergency_freeze", "emergency_due")


def cases(only=None) -> list:
    """[(имя, файл фикстуры)] — все фикстуры v9 с диска (сценарии ред. 9.1 — скриптовые 213-220, ред. 9.2.1/9.2.2 и пакета
    безопасности — 240-255, ред. 9.3/9.3.1/9.3.1.1 — частичное закрытие 231-235, 300-303, 310-311), КРОМЕ
    `EXCLUDED_FIXTURES` (сегодня пусто; ред. 9.4 — замороженный пул 236-239, 260, 261 — в прогоне)."""
    files = sorted(glob.glob(os.path.join(FIXTURES, "scenario_*.json")))
    if len(files) == 0:
        raise ValueError(f"фикстур не найдено в {FIXTURES}")
    names = {os.path.basename(f) for f in files}
    gone = sorted(set(EXCLUDED_FIXTURES) - names)
    if gone:
        raise ValueError(f"исключённых фикстур нет на диске: {gone} — список исключений устарел")
    return [(os.path.basename(f), f) for f in files
            if os.path.basename(f) not in EXCLUDED_FIXTURES and (not only or only in os.path.basename(f))]


def run_many(art: dict, jobs: list, workers: int, stop_on_red: bool = False) -> dict:
    """[(ключ, файл, paged)] -> {ключ: (расхождения, секунды)}. Каждая фикстура — своя цепь; их гонят `workers` потоков
    (работа — ожидание anvil, а не питон). `stop_on_red` — после первого расхождения новые не начинаются (их ключей в
    ответе нет)."""
    from concurrent.futures import ThreadPoolExecutor
    out = {}; red = threading.Event()

    def one(key, f, paged):
        if stop_on_red and red.is_set():
            return
        t0 = time.time(); bad = run_fixture(art, f, False, paged)
        out[key] = (bad, time.time() - t0)
        if bad:
            red.set()
    with ThreadPoolExecutor(max_workers=max(1, workers)) as ex:
        for fut in [ex.submit(one, *j) for j in jobs]:
            fut.result()
    return out


# --- очередь заявок: сценарии эталона с ДЛИННОЙ очередью ----------------------------------------------------- #
# Фикстуры v8 держат в очереди не больше 5 заявок (замер 17.10), а очередь контракта — полоса сумм по ключу и поиск точки
# упора по id (`_fifoPay`): судить её надо там, где заявок много, ключи перемежаются, ликвидность упирается посреди потока,
# каскад убытка снимает хвост, а новая заявка встаёт после снятого хвоста. Сценарии генерирует ЭТАЛОН (суммы — по его
# состоянию), трассу — его же `replay`; дифференциал судит их так же, как фикстуры.
def reference():
    return sys.modules.get("vault_accounting_ref") or SourceFileLoader(
        "vault_accounting_ref", os.path.join(ROOT, "runtime", "vault_accounting.pytxt")).load_module()


def queue_calls(seed: int, n_ops: int = 320) -> list:
    VA = reference(); rng = random.Random(seed); L = VA._scenario_ledger(); calls = []; npid = 0
    addrs = [VA.A_(i) for i in range(1, 9)]

    def step(c):
        calls.append(c); VA.apply_call(L, c)
    for i, a in enumerate(addrs):
        step({"call": "deposit", "addr": a, "amount": rng.randint(200, 3000) * 10 ** 6, "referrer": None,
              "payout": rng.random() < 0.3, "path": "evm", "ledger_ref": None})
    step({"call": "sweep_to_perp"})
    ops = ["wtiny"] * 22 + ["wfrac"] * 6 + ["rw"] * 3 + ["wd"] * 7 + ["pay"] * 5 + ["size"] * 4 + ["fill"] * 4 +           ["mark"] * 4 + ["close"] * 3 + ["cancel"] + ["monday"] * 3 + ["claim"] * 3 + ["dep"] * 3 + ["payout"] * 2 + ["sweep"] * 2
    for _ in range(n_ops):
        op = rng.choice(ops); a = rng.choice(addrs); c = None
        if op in ("wtiny", "wfrac"):
            free = L.free_stake(a)
            if free:
                amt = rng.choice([1, rng.randint(1, 10 ** 6), rng.randint(1, 10 ** 8)]) if op == "wtiny" else free * rng.randint(1000, 10_000) // 10_000
                c = {"call": "withdraw", "addr": a, "reward": False, "amount": max(1, min(free, amt))}
        elif op == "rw":
            who = rng.choice(addrs + [VA.SCENARIO_TREASURY]); free = L.free_stake(who, True)
            if free:
                c = {"call": "withdraw", "addr": who, "reward": True, "amount": max(1, free * rng.randint(1000, 10_000) // 10_000)}
        elif op == "wd":
            c = {"call": "set_withdrawable", "amount": max(0, L.venue_value()) * rng.randint(0, 10_000) // 10_000}
        elif op == "pay":
            c = {"call": "pay_queue"}
        elif op == "size":
            c = {"call": "size_order", "pid": f"q{npid}", "notional": L.sizing_capital() * rng.randint(2000, 30_000) // 10_000}
            npid += 1
        elif op in ("fill", "cancel", "mark", "close"):
            want = "sized" if op in ("fill", "cancel") else "open"
            pids = sorted(q for q, o in L.orders.items() if o["state"] == want)
            if pids:
                q = rng.choice(pids); x = L.orders[q]["notional"] * rng.randint(-8000, 3000) // 10_000
                c = {"fill": {"call": "fill_order", "pid": q}, "cancel": {"call": "cancel_order", "pid": q},
                     "mark": {"call": "mark_position", "pid": q, "upnl": x}, "close": {"call": "close_position", "pid": q, "realized": x}}[op]
        elif op == "monday":
            step({"call": "monday"}); c = {"call": "treasury_payout"}
        elif op == "claim":
            c = {"call": "claim", "addr": rng.choice(addrs + [VA.SCENARIO_TREASURY])}
        elif op == "dep":
            c = {"call": "deposit", "addr": a, "amount": rng.randint(1, 2000) * 10 ** 6, "referrer": None, "payout": None,
                 "path": "evm", "ledger_ref": None}
        elif op == "payout":
            c = {"call": "set_payout_mode", "addr": a, "payout": rng.random() < 0.5}
        elif op == "sweep":
            c = {"call": "sweep_to_perp"}
        if c is not None:
            step(c)
    return calls


def queue_fixture(seed: int) -> dict:
    return ref_fixture(queue_calls(seed))


# --- зачёт циклов книги (ред. 9.2): сценарии эталона с ПЛОТНОЙ книгой доплативших ------------------------------------ #
# Фикстуры 221-224 держат два-три адреса: путь зачёта там один, работа получателя в очереди возвратов не встречается дважды,
# а порядок адресов совпадает с порядком регистрации. Порядок соседей поиска пути, порядок записи долей одного должника
# (по адресу, а не по регистрации), слияние работ и то, что поиск видит книгу ровно на момент записи, судят сценарии
# `cycle_NNN` (`--cycles N`): 10 адресов, зарегистрированных НЕ по возрастанию, 16 недель; каждую неделю часть вносит,
# ордер на 1.0-1.4 капитала, 1-3 «выходят» до закрытия (их доля убытка — недостача, её доплачивают остальные), убыток
# 40-70 % или прибыль 5-40 %. Книга растёт и замыкается (бывший доплативший становится должником того, за кого платил).
# `cycle_pool` — скриптовый: недостачу A частью доплачивает B своим реферальным вознаграждением, а сам B в той же неделе
# должен ПУЛУ (дыра): долг перед пулом в цикл не входит.
def cycle_calls(seed: int, weeks: int = 16, n: int = 10) -> list:
    VA = reference(); rng = random.Random(seed); L = VA._scenario_ledger(); calls = []; npid = 0
    addrs = [VA.A_(0xd000 + x) for x in rng.sample(range(1, 250), n)]
    dep = lambda a, usd: {"call": "deposit", "addr": a, "amount": usd * VA.USD, "referrer": None, "payout": None, "path": "evm",
                          "ledger_ref": None}

    def step(c):
        calls.append(c); VA.apply_call(L, c)
    for a in addrs:
        step(dep(a, rng.randint(200, 3000)))
    for _ in range(weeks):
        for a in addrs:
            if rng.random() < 0.5:
                step(dep(a, rng.randint(50, 2000)))
        step({"call": "sweep_to_perp"})
        cap = L.sizing_capital()
        if cap <= 0:
            continue
        pid = f"c{npid}"; npid += 1
        step({"call": "size_order", "pid": pid, "notional": cap * rng.randint(10_000, 14_000) // 10_000})
        step({"call": "fill_order", "pid": pid})
        if pid not in L.orders:
            continue
        losers = rng.sample(addrs, rng.randint(1, 3))
        for a in losers:
            free = L.free_stake(a)
            if free:
                step({"call": "withdraw", "addr": a, "reward": False, "amount": free})
        step({"call": "set_withdrawable", "amount": max(0, L.venue_value())})
        step({"call": "pay_queue"})
        for a in losers:
            step({"call": "claim", "addr": a})
        if L.orders.get(pid, {}).get("state") == "open":
            pm = rng.randint(-700, -400) if rng.random() < 0.6 else rng.randint(50, 400)
            step({"call": "close_position", "pid": pid, "realized": L.orders[pid]["notional"] * pm // 1000})
        step({"call": "set_withdrawable", "amount": max(0, L.venue_value())})
        step({"call": "monday"})
        step({"call": "treasury_payout"})
    return calls


def cycle_pool_calls() -> list:
    VA = reference(); L = VA._scenario_ledger(); calls = []; U = VA.USD
    A, B, C = VA.A_(0xe1), VA.A_(0xe2), VA.A_(0xe3)
    dep = lambda a, usd, ref=None: {"call": "deposit", "addr": a, "amount": usd * U, "referrer": ref, "payout": None,
                                    "path": "evm", "ledger_ref": None}

    def step(c):
        calls.append(c)
        if not VA.apply_call(L, c):
            raise ValueError(f"cycle_pool: эталон отклонил {c}")
    for c in (dep(A, 1000), dep(B, 1000), {"call": "sweep_to_perp"}, {"call": "size_order", "pid": "g1", "notional": 2000 * U},
              {"call": "fill_order", "pid": "g1"}):
        step(c)
    for a in (A, B):
        step({"call": "withdraw", "addr": a, "reward": False, "amount": L.free_stake(a)})
    step({"call": "set_withdrawable", "amount": max(0, L.venue_value())}); step({"call": "pay_queue"})
    for a in (A, B):
        step({"call": "claim", "addr": a})
    for c in (dep(C, 10, ref=B), {"call": "sweep_to_perp"}, {"call": "size_order", "pid": "g2", "notional": 100 * U},
              {"call": "fill_order", "pid": "g2"}, {"call": "close_position", "pid": "g2", "realized": 700 * U}):
        step(c)
    step({"call": "close_position", "pid": "g1", "realized": -(L.venue_value() - 5 * U)})
    step({"call": "set_withdrawable", "amount": max(0, L.venue_value())}); step({"call": "monday"})
    if not (L.creditors.get(A, {}).get(B) and L.creditors.get(B, {}).get(None)):
        raise ValueError(f"cycle_pool: книга без A -> B и B -> пул: {L.creditors}")
    return calls


# --- ред. 9.2.1: книга «обратный треугольник» (i должен всем j < i) — худший вход проекции фазы 2 (спека 8.11.1) ----- #
# Фикстуры 240-252 держат два-шесть адресов: проекция там — одна-две работы. Здесь возврат должника идёт по всем рёбрам
# вниз, а получатели сами должники: работ — волнами, слияние в каждой волне, недостача по маркам рядом (поколения с
# бумажным убытком). Та же конструкция, что у forge-стенда газа `test_rev921_triangle_*` (PoolLedgerGasTest).
def triangle_calls(n: int = 12, G: int = 2) -> list:
    VA = reference(); L = VA._scenario_ledger(); calls = []; U = VA.USD
    A = [VA.A_(0x5000 + i) for i in range(n)]

    def step(c, must=True):
        calls.append(c)
        if not VA.apply_call(L, c) and must:
            raise ValueError(f"triangle: эталон отклонил {c}")
    dep = lambda a, x: {"call": "deposit", "addr": a, "amount": x, "referrer": None, "payout": None, "path": "evm", "ledger_ref": None}
    step(dep(A[0], 1000 * U))
    for k in range(1, n):
        step(dep(A[k], 1000 * U)); step({"call": "sweep_to_perp"})
        nt = L.sizing_capital() // 10; pid = f"t{k}"
        step({"call": "size_order", "pid": pid, "notional": nt}); step({"call": "fill_order", "pid": pid})
        free = L.free_stake(A[k])
        step({"call": "set_withdrawable", "amount": free}); step({"call": "withdraw", "addr": A[k], "reward": False, "amount": free})
        step({"call": "claim", "addr": A[k]})
        step({"call": "close_position", "pid": pid, "realized": -(nt * 99 // 100)}); step({"call": "set_withdrawable", "amount": 0})
        step({"call": "monday"})
        for j in range(k + 1):
            s_ = L.free_stake(A[j])
            if s_ < 1000 * U:
                step(dep(A[j], 1000 * U - s_))
    if sum(1 for a in L.creditors for b in L.creditors[a] if b is not None) != n * (n - 1) // 2:
        raise ValueError("triangle: книга не «i должен всем j < i»")
    step({"call": "sweep_to_perp"})
    for j in range(G):
        pid = f"g{j}"
        step({"call": "size_order", "pid": pid, "notional": n * 10 * U}); step({"call": "fill_order", "pid": pid})
        step({"call": "mark_position", "pid": pid, "upnl": -(j + 1) * U})
    step({"call": "size_order", "pid": "win", "notional": n * 100 * U}); step({"call": "fill_order", "pid": "win"})
    step({"call": "close_position", "pid": "win", "realized": n * U})
    if not L._repay_projection()["stake"]:
        raise ValueError("triangle: проекция возврата пуста — сценарий не судит вес 9.2.1")
    step({"call": "size_order", "pid": "probe", "notional": n * U})
    step({"call": "set_withdrawable", "amount": max(0, L.venue_value())})
    step({"call": "withdraw", "addr": A[1], "reward": False, "amount": 10 * U}, must=False)
    step({"call": "claim", "addr": A[1]}, must=False)
    step(dep(A[1], 10 * U), must=False)
    step({"call": "pay_queue"})
    for pid in [q for q, o in L.orders.items() if o["state"] == "open"]:
        step({"call": "close_position", "pid": pid, "realized": L.orders[pid]["upnl"]})
    step({"call": "set_withdrawable", "amount": max(0, L.venue_value())})
    step({"call": "monday"})
    return calls


def cycle_cases(n: int) -> list:
    """[(имя, словарь-фикстура)] — скриптовые `cycle_pool` и `triangle_012`, затем `n` случайных сценариев плотной книги
    (seed 0..n−1); пусто при n = 0."""
    if n <= 0:
        return []
    return ([("cycle_pool", ref_fixture(cycle_pool_calls())), ("triangle_012", ref_fixture(triangle_calls()))]
            + [(f"cycle_{s:03d}", ref_fixture(cycle_calls(s))) for s in range(n)])


def ref_fixture(calls: list) -> dict:
    """Вызовы -> фикстура: трассу (принятие, состояние, витрины) пишет ЭТАЛОН своим `replay`."""
    VA = reference(); L, trace = VA.replay(calls)
    return json.loads(json.dumps({"schema": VA.FIXTURE_SCHEMA, "constants": {
        "fee_bps": L.fee_bps, "ref_share_bps": L.ref_share_bps, "open_ref_share_bps": L.open_ref_share_bps,
        "hold_bps": L.hold_bps, "buffer_bps": L.buffer_bps, "treasury": L.treasury, "partners": list(VA.SCENARIO_PARTNERS),
        "partner_term_weeks": L.partner_term_weeks, "min_deposit": L._min_deposit, "max_investors": L._max_investors},
        "calls": calls, "trace": trace}, default=str))


def queue_cases(n: int) -> list:
    """[(имя, словарь-фикстура)] — `n` сценариев с длинной очередью (seed 0..n−1)."""
    return [(f"queue_{s:03d}", queue_fixture(s)) for s in range(n)]


def cmd_run(args) -> int:
    art = build()
    todo = cases(args.only) + queue_cases(args.fuzz) + cycle_cases(args.cycles)
    if not todo:
        raise ValueError(f"ничего не выбрано по «{args.only}»")
    if args.verbose:
        res = {}
        for n, f in todo:
            t0 = time.time(); res[n] = (run_fixture(art, f, True, args.paged), time.time() - t0)
    else:
        res = run_many(art, [(n, f, args.paged) for n, f in todo], args.jobs)
    fails = 0
    for name, _ in todo:
        bad, sec = res[name]
        if bad:
            fails += 1
            print(f"[FAIL] {name} ({sec:.1f} с)")
            for x in bad:
                print("   ", x)
        else:
            print(f"[OK]   {name} ({sec:.1f} с)")
    form = "" if not args.paged else " --paged" if args.paged == 1 else f" --paged-k {args.paged}"
    print(f"DIFF{form}: {'PASS' if not fails else 'FAIL'} ({len(todo) - fails}/{len(todo)})")
    if args.fuzz:
        VA = reference(); qmax = 0
        for name, d in todo[len(todo) - args.fuzz - (args.cycles + 2 if args.cycles > 0 else 0):][:args.fuzz]:
            qmax = max(qmax, max(len(t["state"]["queue"]) for t in d["trace"]))
        print(f"   сценарии очереди: {args.fuzz}, наибольшая очередь {qmax} заявок")
    return 1 if fails else 0



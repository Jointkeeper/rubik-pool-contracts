def forge_red(contract: str) -> list:
    """Судья-стенды: имена упавших тестов контракта `contract` (пусто — все зелёные). Ошибка самого forge (сборка, а не
    тест) — отказ: мутант, который не собирается, ничего не доказывает."""
    r = subprocess.run([foundry("forge"), "test", "--match-contract", contract], cwd=CONTRACTS,
                       capture_output=True, text=True, encoding="utf-8", env=dict(os.environ, FOUNDRY_LINT_LINT_ON_BUILD="false"))
    import re
    red = list(dict.fromkeys((re.search(r"\]\s+(\w+)\(", ln) or re.search(r"(.{0,120})", ln)).group(1)
                             for ln in r.stdout.splitlines() if ln.startswith("[FAIL")))
    if r.returncode != 0 and not red:
        raise ValueError(f"forge test упал не на тесте: {r.stdout[-1500:]}{r.stderr[-1500:]}")
    if r.returncode == 0 and red:
        raise ValueError(f"forge test: rc 0 при упавших тестах {red}")
    return red


def mutate(text: str, name: str, rule) -> str:
    """Применить мутант к тексту исходника; каждый образец — ровно один раз, иначе правило устарело (отказ)."""
    for a, b in (rule if isinstance(rule, list) else [rule]):
        if text.count(a) != 1:
            raise ValueError(f"мутант «{name}»: образец встречается {text.count(a)} раз — правило устарело")
        if a == b:
            raise ValueError(f"мутант «{name}»: замена совпадает с образцом")
        text = text.replace(a, b)
    return text


def select_mutants(table: dict, args) -> dict:
    names = list(table)
    start = next((i for i, k in enumerate(names) if args.start in k), None) if args.start else 0
    if start is None:
        raise ValueError(f"мутанта с «{args.start}» в имени нет")
    lo, hi = (int(x) if x else None for x in args.range.split(":")) if getattr(args, "range", None) else (None, None)
    pick = names[start:][lo:hi]                         # `--range A:B` — часть таблицы по индексам (прогон частями)
    chosen = {k: table[k] for k in pick if not args.only or args.only in k}
    if not chosen:
        raise ValueError(f"мутантов с «{args.only}» в имени нет")
    return chosen


def mutants_lock(root: str) -> str:
    """Замок дерева на время саботажа: `root/.mutants.lock`, создание с O_EXCL. Второй раннер в ТОМ ЖЕ дереве — отказ с
    именем замка. Причина (замер 20.10, слияние rev9 × 9.4): раннер пишет мутант в исходник своего дерева и собирает его
    `out/`; второй процесс, стартовав, когда в файле уже лежит чужой мутант, принимает его за «исходник», судит чужой
    мутант своим судьёй и в конце «восстанавливает» дерево в мутированное (sha сходится — с его же неверным оригиналом).
    Замок остаётся после убитого процесса — удалить руками, убедившись, что исходник равен `git show HEAD:…`."""
    path = os.path.join(root, ".mutants.lock")
    try:
        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
    except FileExistsError:
        raise ValueError(f"мутанты уже идут в этом дереве ({path}): части --range — каждая в своём ворктри "
                         "(git worktree add --detach); замок от убитого прогона — удалить руками после сверки исходника")
    os.write(fd, str(os.getpid()).encode()); os.close(fd)
    return path


def sabotage(source: str, chosen: dict, judge, lock_root: str = CONTRACTS) -> list:
    """Каждый мутант по очереди: записать в `source`, спросить `judge(name)` (список покрасневших судей), вернуть
    исходник. Исходник восстанавливается при любом исходе, и это проверяется sha до и после. Возврат — выжившие.
    Один раннер на дерево (`mutants_lock`)."""
    import hashlib
    lock = mutants_lock(lock_root)
    try:
        return _sabotage(source, chosen, judge, hashlib)
    finally:
        os.remove(lock)


def _sabotage(source: str, chosen: dict, judge, hashlib) -> list:
    orig = open(source, "rb").read(); sha = hashlib.sha256(orig).hexdigest()
    alive = []
    try:
        for name, rule in chosen.items():
            open(source, "wb").write(mutate(orig.decode("utf-8"), name, rule).encode("utf-8"))
            red = judge(name)
            print(f"[{'OK' if red else 'FAIL'}] мутант «{name}»: краснеют {red or 'НИ ОДНА'}")
            if not red:
                alive.append(name)
    finally:
        open(source, "wb").write(orig)
        build()
    if hashlib.sha256(open(source, "rb").read()).hexdigest() != sha:
        raise ValueError(f"исходник {source} не восстановлен после саботажа")
    print(f"MUTANTS{' --vault' if source in (VAULT_SOURCE, VAULT_EM_SOURCE) else ''}: {'PASS' if not alive else 'FAIL'} "
          f"({len(chosen) - len(alive)}/{len(chosen)} пойманы)")
    return alive


def cmd_mutants(args) -> int:
    """Бухгалтерия: каждый мутант обязан покраснеть хотя бы на одной фикстуре — атомарным расчётом или пачками (а если
    все зелёные — на forge-стендах). Хранилище (`--vault`): на forge-стендах `PoolVaultTest` и `PoolVaultEmergencyTest` —
    мутанты `PoolVault.sol` (VAULT_MUTANTS), затем модуля аварии `PoolVaultEmergency.sol` (VAULT_EM_MUTANTS); раннер один."""
    if args.vault:
        judge = lambda _: forge_red("PoolVault(Emergency)?Test")
        alive = []
        for source, table in ((VAULT_SOURCE, VAULT_MUTANTS), (VAULT_EM_SOURCE, VAULT_EM_MUTANTS)):
            try:
                chosen = select_mutants(table, args)
            except ValueError:
                continue                                 # `--only`/`--start` не про этот файл
            alive += sabotage(source, chosen, judge)
        return 1 if alive else 0
    files = cases() + queue_cases(args.fuzz) + cycle_cases(args.cycles)

    def judge(_name):
        art = build()
        # судья — обе формы расчёта: атомарный `monday()` и пачками по одной единице (`--paged`)
        res = run_many(art, [((fname, paged), f, paged) for paged in (False, True) for fname, f in files], args.jobs,
                       stop_on_red=not args.all)
        red = [f"{fname}{' (пачками)' if paged else ''}" for (fname, paged), (bad, _) in sorted(res.items()) if bad]
        if not red and forge_red("PoolLedger(Emergency|Gens)?Test"):          # ред. 9.5: и стенды права/предела поколений
            red.append("forge:PoolLedger(Emergency|Gens)Test")
        return red
    return 1 if sabotage(SOURCE, select_mutants(MUTANTS, args), judge) else 0


# --- selftest ------------------------------------------------------------------------------------------------- #
def selftest() -> int:
    ok = []

    def chk(name, cond, detail=""):
        ok.append(bool(cond)); print(f"  [{'OK' if cond else 'FAIL'}] {name} {detail}")
    # кодек против `cast abi-encode` — независимый кодировщик
    vectors = [(["address", "uint256", "int256", "bool", "uint8", "bytes32"],
                ["0x0000000000000000000000000000000000000fee", 2 ** 128 - 1, -(2 ** 127) + 1, True, 3, id32("w")]),
               (["int256", "int256", "uint256"], [-1, 7, 0]),
               (["bytes32", "address"], [id32("op3-15-1"), "0x00000000000000000000000000000000000000ff"])]
    cast = foundry("cast")
    for types, vals in vectors:
        arg = [f"f({','.join(types)})"] + [("0x" + v.hex()) if isinstance(v, bytes) else (str(v).lower() if isinstance(v, bool) else str(v))
                                            for v in vals]
        r = subprocess.run([cast, "abi-encode"] + arg, capture_output=True, text=True)
        chk(f"C1: кодек совпадает с cast abi-encode {types}", r.returncode == 0 and r.stdout.strip() == "0x" + ABI.encode(types, vals).hex(),
            r.stderr.strip()[:120])
    words = [5, -3, 2 ** 200]
    blob = (32).to_bytes(32, "big") + len(words).to_bytes(32, "big") + b"".join((w % ABI.U256).to_bytes(32, "big") for w in words)
    chk("C2: декодер int256[] читает знаковые и большие слова", ABI.dec_int_array(blob) == words)
    chk("C3: id32 — круг строка -> bytes32 -> строка", un_id32(int.from_bytes(id32("op3-15-1"), "big")) == "op3-15-1")
    bad = None
    try:
        id32("x" * 33)
    except ValueError as e:
        bad = e
    chk("C4: id32 длиннее 32 байт — ValueError, а не обрезка", bad is not None)
    a = {"x": {"y": 1, "z": 2}}; b = {"x": {"y": 1, "z": 3}}
    chk("C5: diff называет путь и оба значения", diff(a, b) == ["/x/z: эталон 2 контракт 3"])
    caught = None
    try:
        views_abi_only_reads({"abi": [{"type": "function", "name": "dump", "stateMutability": "view"},
                                      {"type": "function", "name": "sneak", "stateMutability": "nonpayable"}]})
    except ValueError as e:
        caught = str(e)
    chk("C6: изменяющая функция в ABI витрин — отказ с именем (delegatecall писал бы в память бухгалтерии)", caught and "sneak" in caught)
    vtext = open(VAULT_SOURCE, encoding="utf-8").read()
    stale = []
    for name, rule in VAULT_MUTANTS.items():
        try:
            mutate(vtext, name, rule)
        except ValueError as e:
            stale.append(str(e))
    chk(f"C7: каждый образец VAULT_MUTANTS ({len(VAULT_MUTANTS)}) встречается в PoolVault.sol ровно один раз", not stale,
        "; ".join(stale)[:300])
    etext = open(VAULT_EM_SOURCE, encoding="utf-8").read()
    stale = []
    for name, rule in VAULT_EM_MUTANTS.items():
        try:
            mutate(etext, name, rule)
        except ValueError as e:
            stale.append(str(e))
    chk(f"C7c: каждый образец VAULT_EM_MUTANTS ({len(VAULT_EM_MUTANTS)}) встречается в PoolVaultEmergency.sol ровно один раз",
        not stale, "; ".join(stale)[:300])
    ltext = open(SOURCE, encoding="utf-8").read()
    stale = []
    for name, rule in MUTANTS.items():
        try:
            mutate(ltext, name, rule)
        except ValueError as e:
            stale.append(str(e))
    chk(f"C7b: каждый образец MUTANTS ({len(MUTANTS)}) встречается в PoolLedger.sol ровно один раз", not stale,
        "; ".join(stale)[:300])
    dup = None
    try:
        mutate("x x", "двойной", ("x", "y"))
    except ValueError as e:
        dup = e
    chk("C8: образец, встреченный дважды, — отказ, а не саботаж обоих мест", dup is not None)
    # C20: второй раннер мутантов в том же дереве — отказ до записи исходника (гонка частей --range в одном ворктри)
    import tempfile
    with tempfile.TemporaryDirectory() as td:
        src = os.path.join(td, "S.sol"); open(src, "w", encoding="utf-8").write("x")
        held = mutants_lock(td)
        touched, refused = [], None
        try:
            sabotage(src, {"m": ("x", "y")}, lambda n: touched.append(n) or ["j"], lock_root=td)
        except ValueError as e:
            refused = e
        os.remove(held)
        free = sabotage(src, {"m": ("x", "y")}, lambda n: ["j"], lock_root=td) == [] and not os.path.exists(held)
        chk("C20: второй раннер мутантов в том же дереве — отказ, исходник не тронут; после снятия замка — прогон и замок снят",
            refused is not None and not touched and open(src, encoding="utf-8").read() == "x" and free)
    # ред. 9.4 перенесена: фикстуры с вызовами аварии — В ПРОГОНЕ (ни одна не исключена), и кодек знает оба вызова
    with_emergency = sorted(os.path.basename(f) for f in glob.glob(os.path.join(FIXTURES, "scenario_*.json"))
                            if any(c["call"] in EMERGENCY_CALLS for c in json.load(open(f, encoding="utf-8"))["calls"]))
    c17 = (with_emergency == [f"scenario_{n}.json" for n in (236, 237, 238, 239, 260, 261)]
           and not set(with_emergency) - {n for n, _ in cases()} and not EXCLUDED_FIXTURES)
    chk(f"C17: фикстуры аварии ред. 9.4 ({len(with_emergency)}) — в прогоне, исключений нет", c17,
        "" if c17 else f"с аварией {with_emergency}, исключены {sorted(EXCLUDED_FIXTURES)}")
    run_names = {n for n, _ in cases()}
    with_parts = sorted(os.path.basename(f) for f in glob.glob(os.path.join(FIXTURES, "scenario_*.json"))
                        if any(c["call"] == "reduce_position" for c in json.load(open(f, encoding="utf-8"))["calls"]))
    out = sorted(set(with_parts) - run_names)
    chk(f"C18: все фикстуры с частями ({len(with_parts)}) — в прогоне", with_parts and not out, f"вне прогона: {out}" if out else "")
    # КЕ10: деплой частями — раскладка, размеры, связность и проверка после деплоя (на своей цепи)
    art = build()
    lay = storage_layout()
    chk(f"C9: раскладка памяти {'/'.join(LEDGER_PARTS)} одна",
        {"owner", "viewsImpl", "mondayImpl", "projImpl", "emergencyImpl", "bookImpl", "emState"} <= set(lay))
    base = layout_of(LEDGER_PARTS[0])
    moved = ([base[0][1], base[0][0]] + base[0][2:], base[1])
    chk("C10: раскладка с переставленной переменной — расхождение, а не равенство", layout_mismatch(base, moved) is not None)
    try:
        sizes = code_sizes(art); why = ""
    except ValueError as e:
        sizes = None; why = str(e)
    chk("C11: все части в EIP-170, initcode каждой — в EIP-3860", sizes is not None, why)
    chain = Chain()
    try:
        m = deploy_pool(chain, art, rehearsal_constants(), rehearsal_roles())
        rehearsal_core(chain)
        clean = postdeploy_check(chain, m, art)
        chk("C12: деплой частями на вычисленный адрес — проверка после деплоя чиста", clean == [], "; ".join(clean)[:300])
        # ревью-2, #7: та же проверка командой `postdeploy` по RPC-адресу (как боевая цепь) — только чтение: ни блока, ни nonce
        import tempfile
        tmp = tempfile.mkdtemp(prefix="pd_")
        mf = os.path.join(tmp, "manifest.json"); json.dump(m, open(mf, "w", encoding="utf-8"))
        bn0, nc0 = chain.rpc("eth_blockNumber"), chain.rpc("eth_getTransactionCount", chain.me, "latest")
        cmd = [sys.executable, os.path.abspath(__file__), "postdeploy", "--rpc", chain.url, "--manifest", mf, "--spacing", "0"]
        r = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8")
        t = json.loads(json.dumps(m)); t["roles"]["terms"]["t_dead"] = int(t["roles"]["terms"]["t_dead"]) + 1
        mf_bad = os.path.join(tmp, "bad.json"); json.dump(t, open(mf_bad, "w", encoding="utf-8"))
        rb = subprocess.run(cmd[:6] + [mf_bad] + cmd[7:], capture_output=True, text=True, encoding="utf-8")
        same = (chain.rpc("eth_blockNumber"), chain.rpc("eth_getTransactionCount", chain.me, "latest")) == (bn0, nc0)
        chk("C26: `postdeploy --rpc` по своему anvil — PASS на чистом манифесте, FAIL с именем срока на подменённом; "
            "блок и nonce цепи не сдвинулись (только чтение)",
            r.returncode == 0 and "POSTDEPLOY: PASS" in r.stdout and rb.returncode == 1
            and "PoolVaultEmergency.T_DEAD()" in rb.stdout and same, (r.stdout + r.stderr)[-300:] + (rb.stdout + rb.stderr)[-300:])
        refused = []
        for meth in ("eth_sendTransaction", "eth_sendRawTransaction", "anvil_setCode", "eth_sign", "eth_getProof"):
            try:
                RemoteChain(chain.url, 0).rpc(meth)
            except ValueError:
                refused.append(meth)
        chk("C27: RemoteChain отказывает ДО сети всему вне перечня только-чтения (отправка, подпись, anvil_*)",
            len(refused) == 5, f"пропущены {set(('eth_sendTransaction', 'eth_sendRawTransaction', 'anvil_setCode', 'eth_sign', 'eth_getProof')) - set(refused)}")
        # ревью-2, #5 / H1: граница T_QUEUE_MAX выводится из владельца и параметров — подмена запаса или слагаемых названа
        t = json.loads(json.dumps(m)); t["roles"]["queue_floor"]["keeper_margin_s"] = int(m["roles"]["terms"]["t_queue_max"])
        floor_named = any(x.startswith("PoolVaultEmergency.T_QUEUE_MAX() =") and "короче выведенной границы" in x
                          for x in postdeploy_check(chain, t, art))
        t = json.loads(json.dumps(m)); del t["roles"]["queue_floor"]
        try:
            postdeploy_check(chain, t, art); no_floor = None
        except ValueError as e:
            no_floor = str(e)
        t = json.loads(json.dumps(m)); t["roles"]["delay"] = int(m["roles"]["delay"]) - 1
        delay_named = any(x.startswith("PoolVault.DELAY() =") for x in postdeploy_check(chain, t, art))
        P_ = load_params()
        fc = config_number(P_["roles"]["queue_floor"]["force_close_source"])
        chk("C28: T_QUEUE_MAX короче выведенной границы — назван; манифест без queue_floor — отказ, а не «чисто»; DELAY не "
            "манифеста — назван; граница беты = (закрытие владельца + расчёт) сут + запас",
            floor_named and no_floor and delay_named
            and queue_max_floor(P_["roles"])[0] == (int(fc) + 7) * DAY_S + P_["roles"]["queue_floor"]["keeper_margin_s"]
            and P_["roles"]["terms"]["t_queue_max"] >= queue_max_floor(P_["roles"])[0], f"{floor_named} {no_floor} {delay_named}")
        bad_roles = json.loads(json.dumps(P_)); bad_roles["roles"]["admin"] = "0x" + "11" * 20
        try:
            rehearsal_roles(bad_roles); leaked = None
        except ValueError as e:
            leaked = str(e)
        delay_ = P_["roles"]["delay"]
        chk("C29: параметры беты — DELAY >= MIN_DELAY исходника, каждый срок >= 2·DELAY, ставки комиссии TBD, адрес роли в "
            "файле параметров — отказ",
            delay_ >= min_delay() and all(v >= 2 * delay_ for v in P_["roles"]["terms"].values())
            and set(P_["tbd"]) == {"fee_bps", "ref_share_bps", "open_ref_share_bps"} and leaked,
            f"{P_['tbd']} {leaked}")
        t = json.loads(json.dumps(m)); t["parts"]["TradingLegB"]["codehash"] = "0x" + "0" * 64
        chk("C13: подменённый codehash — проверка называет часть",
            any(x.startswith("TradingLegB: codehash") for x in postdeploy_check(chain, t, art)))
        stray = deploy_code(chain, art["leg"]["bytecode"]["object"] + encode(["address"], [REHEARSAL_ADDR["admin"]]).hex(), "нога")
        t = json.loads(json.dumps(m)); t["parts"]["TradingLegA"]["address"] = stray
        bad = postdeploy_check(chain, t, art)
        chk("C14: нога чужого хранилища в манифесте — immutable и vault() не те, хранилище не на неё",
            any(x.startswith("TradingLegA: immutable") for x in bad) and any("TradingLegA.vault()" in x for x in bad)
            and any("PoolVault.legA()" in x for x in bad), "" if bad else "проверка чиста")
        t = json.loads(json.dumps(m)); t["parts"]["PoolLedgerViews"]["address"] = m["parts"]["PoolLedgerProj"]["address"]
        bad = postdeploy_check(chain, t, art)
        chk("C15: реализация не та — код не равен сборке и слот viewsImpl не тот",
            any(x.startswith("PoolLedgerViews: код") for x in bad) and any("PoolLedger.viewsImpl" in x for x in bad),
            "" if bad else "проверка чиста")
        burned = None
        try:
            deploy_pool(chain, art, rehearsal_constants(), rehearsal_roles(), burn_nonce=True)
        except ValueError as e:
            burned = str(e)
        chk("C16: деплойер потратил nonce до хранилища — хранилище отклонено конструктором", burned and "PoolVault" in burned,
            burned or "хранилище встало")
        # ред. 9.4: модуль аварии хранилища — часть манифеста: чужой модуль (иные сроки) назван и по immutable, и по
        # `PoolVault.emergency()`
        other = deploy_code(chain, art["vault_em"]["bytecode"]["object"] + encode(["uint256"] * len(EM_TERMS), [10 ** 6] * len(EM_TERMS)).hex(), "модуль")
        t = json.loads(json.dumps(m)); t["parts"]["PoolVaultEmergency"]["address"] = other
        t["parts"]["PoolVaultEmergency"]["codehash"] = code_hash(chain, other)
        bad = postdeploy_check(chain, t, art)
        chk("C19: модуль аварии не тот — его сроки и адрес в хранилище не совпадают с манифестом",
            any(x.startswith("PoolVaultEmergency: immutable") for x in bad) and any("PoolVault.emergency()" in x for x in bad),
            "; ".join(bad)[:300] if bad else "проверка чиста")
        # ревью 20.10, п. 7: подмена КАЖДОГО поля манифеста, которое проверка раньше не судила, — названа поимённо
        named = {}
        for k, v in (("treasury", "0x" + "de" * 20), ("buffer_bps", 1), ("fee_bps", 1), ("ref_share_bps", 1),
                     ("hold_bps", 1), ("open_ref_share_bps", 1), ("partner_term_weeks", 1)):
            t = json.loads(json.dumps(m)); t["constants"][k] = v if k == "treasury" else int(m["constants"][k]) + v
            named[k] = any(x.startswith(f"PoolLedger.params().{k} ") for x in postdeploy_check(chain, t, art))
        chk(f"C21: params() бухгалтерии — каждое из семи полей манифеста ({len(named)}) при подмене названо",
            all(named.values()), f"не названы {[k for k, v in named.items() if not v]}")
        t = json.loads(json.dumps(m)); t["chain_id"] = m["chain_id"] + 1
        chk("C22: chain-id манифеста не тот — назван", any(x.startswith("chain_id манифеста") for x in postdeploy_check(chain, t, art)))
        swap = json.loads(json.dumps(m))
        swap["roles"]["terms"]["t_dead"], swap["roles"]["terms"]["t_queue_max"] = (m["roles"]["terms"]["t_queue_max"],
                                                                                   m["roles"]["terms"]["t_dead"])
        bad = postdeploy_check(chain, swap, art)
        chk("C23: сроки модуля аварии переставлены в манифесте — названы по имени (набор immutable тот же)",
            any(x.startswith("PoolVaultEmergency.T_DEAD()") for x in bad)
            and any(x.startswith("PoolVaultEmergency.T_QUEUE_MAX()") for x in bad)
            and not any(x.startswith("PoolVaultEmergency: immutable") for x in bad), "; ".join(bad)[:300])
        act = {}
        for part in ("PoolVault", "TradingLegA", "TradingLegB"):
            rehearsal_core(chain, m["parts"][part]["address"])
            act[part] = [x for x in postdeploy_check(chain, m, art) if "Core" in x]
        rehearsal_core(chain)
        chain.rpc("anvil_setCode", CORE_USER_EXISTS, "0x")
        none = [x for x in postdeploy_check(chain, m, art) if "проверить нечем" in x]
        rehearsal_core(chain)
        # слияние 2026-10-22: бета на ДВЕ ноги (params.beta.json, legShareBps 5000 — решение оператора 21.10). Обязанность
        # ноги быть на Core — по доле манифеста (как у `postdeploy_check`), а не по зашитой «одной ноге»; свойство «нога с
        # долей 0 не обязана» судится отдельно тем же деплоем: манифест с долей BPS (всё ноге A), нога B не на Core — чисто
        share_ = int(m["roles"]["leg_share_bps"])
        need_ = {"PoolVault": True, "TradingLegA": share_ > 0, "TradingLegB": share_ < BPS}
        t = json.loads(json.dumps(m)); t["roles"]["leg_share_bps"] = BPS
        rehearsal_core(chain, m["parts"]["TradingLegB"]["address"])
        zero_b = [x for x in postdeploy_check(chain, t, art) if "Core" in x]
        rehearsal_core(chain)
        chk("C24: хранилище и каждая нога с долей не на Core — названы (доля — из манифеста); нога с долей 0 — не обязана; "
            "цепь без прекомпайла — «проверить нечем», а не «чисто»",
            all(bool(act[k]) == v for k, v in need_.items()) and not zero_b and len(none) == sum(need_.values()),
            f"доля {share_} {act} {zero_b} {none}")
        admin = REHEARSAL_ADDR["admin"]
        chain.rpc("anvil_impersonateAccount", admin); chain.rpc("anvil_setBalance", admin, hex(10 ** 20))

        def as_admin(sig, types, vals):
            h = chain.rpc("eth_sendTransaction", {"from": admin, "to": m["parts"]["PoolVault"]["address"], "gas": hex(GAS),
                                                  "data": "0x" + art["vault"]["methodIdentifiers"][sig] + encode(types, vals).hex()})
            if int(chain.receipt(h)["status"], 16) != 1:
                raise ValueError(f"{sig} от admin не прошёл")
        as_admin("proposeKeeper(address)", ["address"], ["0x" + "de" * 20])
        prop = postdeploy_check(chain, m, art)
        as_admin("setPartner(address,uint8)", ["address", "uint8"], ["0x" + "de" * 20, 1])
        init = postdeploy_check(chain, m, art)
        chk("C25: висящее предложение таймлока и тронутая бухгалтерия — названы",
            prop == ["PoolVault.proposals(1) не пусто: висит предложение таймлока"]
            and any(x.startswith("PoolLedger.status().initialized") for x in init), f"{prop} {init}")
    finally:
        chain.close()
    n = len(ok); p = sum(ok)
    print(f"SELFTEST: {'PASS' if p == n else 'FAIL'} ({p}/{n})")
    return 0 if p == n else 1


def main():
    ap = argparse.ArgumentParser()
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run"); r.add_argument("--only"); r.add_argument("--verbose", action="store_true")
    r.add_argument("--paged", action="store_const", const=1, default=0, help="недельный расчёт пачками по одной единице этапа")
    r.add_argument("--paged-k", type=int, dest="paged", help="то же, пачками по K единиц (K >= 1)")
    r.add_argument("--jobs", type=int, default=8, help="фикстур одновременно (каждая — своя цепь anvil)")
    r.add_argument("--fuzz", type=int, default=0, help="ещё N сценариев эталона с длинной очередью заявок (seed 0..N-1)")
    r.add_argument("--cycles", type=int, default=0, help="ещё `cycle_pool` и N сценариев эталона с плотной книгой доплативших")
    sub.add_parser("selftest")
    rh = sub.add_parser("rehearse-deploy", help="репетиция деплоя КЕ10 на своей цепи: манифест, проверка после, размеры")
    rh.add_argument("--out", help="куда записать манифест (JSON)")
    pd = sub.add_parser("postdeploy", help="проверка после деплоя по реальной цепи: только чтение (eth_call/eth_getCode/…)")
    pd.add_argument("--rpc", required=True, help="RPC-адрес цепи (http/https)")
    pd.add_argument("--manifest", required=True, help="манифест деплоя (JSON, схема pool_deploy_manifest_v1)")
    pd.add_argument("--spacing", type=float, default=1.0, help="секунд между запросами RPC (по умолчанию 1.0)")
    m = sub.add_parser("mutants"); m.add_argument("--all", action="store_true"); m.add_argument("--only")
    m.add_argument("--vault", action="store_true", help="мутанты хранилища PoolVault.sol (судья — forge PoolVaultTest)")
    m.add_argument("--jobs", type=int, default=8, help="фикстур одновременно")
    m.add_argument("--start", help="продолжить с первого мутанта, в имени которого есть подстрока")
    m.add_argument("--range", help="часть таблицы по индексам A:B (после --start), для прогона частями; судья тот же")
    m.add_argument("--fuzz", type=int, default=16, help="и столько сценариев эталона с длинной очередью (seed 0..N-1)")
    m.add_argument("--cycles", type=int, default=8, help="и `cycle_pool` + столько сценариев с плотной книгой (seed 0..N-1)")
    args = ap.parse_args()
    raise SystemExit({"run": cmd_run, "mutants": cmd_mutants, "rehearse-deploy": cmd_rehearse, "postdeploy": cmd_postdeploy}[args.cmd](args)
                     if args.cmd != "selftest" else selftest())


if __name__ == "__main__":
    main()
